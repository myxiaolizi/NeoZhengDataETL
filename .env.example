# ===== 服务端口 =====
PORT=8781
HOST=0.0.0.0
NODE_ENV=production

# ===== 数据库（本应用专用库）=====
# 本机开发（远程连接云服务器数据库）
DB_HOST=tx.zhengl.vip
# 部署到云服务器后改成本机连接
# DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=jdy-push
DB_PASSWORD=your-db-password
DB_NAME=jdy-push
DB_CONNECTION_LIMIT=10

# ===== 表名前缀白名单 =====
# 应用只允许创建/修改/删除以此前缀开头的表，防止误伤同库其他业务表
TABLE_PREFIX=jdywh_

# ===== 会话密钥（部署时请改成随机字符串）=====
SESSION_SECRET=please-change-this-session-secret

# ===== 默认管理员（首次启动自动创建，仅当用户表为空时）=====
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=change-me-on-first-login

# ===== 推送接收 =====
# 单个请求体最大字节数（简道云推送含附件时可能较大）
MAX_BODY_SIZE=20mb
# 是否强制校验 X-JDY-Signature（0=不强制，仅记录校验结果；1=强制）
REQUIRE_SIGNATURE=0
