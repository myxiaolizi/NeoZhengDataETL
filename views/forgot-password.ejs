<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - <%= settings.site_name %></title>
  <link rel="stylesheet" href="/public/css/app.css">
  <% if (settings.theme_color && settings.theme_color !== '#3687FF') { %>
  <style>:root { --primary: <%= settings.theme_color %>; }</style>
  <% } %>
</head>
<body class="login-body">
  <div class="login-bg">
    <div class="orb orb1"></div>
    <div class="orb orb2"></div>
    <div class="orb orb3"></div>
    <div class="login-grid"></div>
  </div>

  <div class="login-shell">
    <div class="login-hero">
      <div class="hero-brand">
        <div class="logo"><%= settings.site_logo_text %></div>
        <div>
          <div class="brand-name"><%= settings.site_name %></div>
          <div class="brand-tag"><%= settings.site_subtitle %></div>
        </div>
      </div>

      <h1>找回密码<br><span class="grad">通过邮箱重置</span></h1>
      <p class="hero-desc">
        输入注册时使用的邮箱地址，系统会向该邮箱发送一封包含重置链接的邮件。<br>
        链接 30 分钟内有效，且只能使用一次。
      </p>

      <div class="hero-features">
        <div class="hero-feature">
          <div class="fi">①</div>
          <div>
            <div class="ft">填写邮箱</div>
            <div class="fd">使用注册时绑定的邮箱地址</div>
          </div>
        </div>
        <div class="hero-feature">
          <div class="fi">②</div>
          <div>
            <div class="ft">查收邮件</div>
            <div class="fd">点击邮件中的「重置密码」按钮</div>
          </div>
        </div>
        <div class="hero-feature">
          <div class="fi">③</div>
          <div>
            <div class="ft">设置新密码</div>
            <div class="fd">设置后即可用新密码登录</div>
          </div>
        </div>
      </div>

      <div class="hero-foot">
        <% if (settings.site_footer) { %><%= settings.site_footer %><br><% } %>
        © <%= new Date().getFullYear() %> <%= settings.site_name %>
      </div>
    </div>

    <div class="login-panel">
      <div class="panel-title">找回密码</div>
      <div class="panel-sub">输入注册邮箱，我们将发送重置链接</div>

      <% if (!mailReady) { %>
      <div class="alert alert-error">系统尚未配置邮件服务，无法发送重置邮件，请联系管理员重置密码</div>
      <% } %>
      <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
      <% } %>
      <% if (info) { %>
      <div class="alert alert-success"><%= info %></div>
      <% } %>

      <form method="post" action="/forgot-password" class="login-form">
        <label class="field">
          <span>注册邮箱</span>
          <input class="input" type="email" name="email" placeholder="请输入注册时使用的邮箱"
                 required autofocus <%= mailReady ? '' : 'disabled' %>>
        </label>

        <button class="btn-login" type="submit" <%= mailReady ? '' : 'disabled' %>>发送重置邮件</button>

        <div class="panel-links" style="justify-content:center">
          <a href="/login">返回登录</a>
        </div>
      </form>
    </div>
  </div>
</body>
</html>