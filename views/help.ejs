let ACTIVE = 'overview';

function renderTabs() {
  document.getElementById('tabs').innerHTML = SECTIONS.map(s =>
    '<button class="tp-item' + (s.key === ACTIVE ? ' active' : '') + '" data-key="' + s.key + '">' +
    s.icon + ' ' + esc(s.title) + '</button>').join('');

  document.querySelectorAll('#tabs .tp-item').forEach(el => {
    el.addEventListener('click', () => { ACTIVE = el.dataset.key; renderTabs(); renderContent(); });
  });
}

function renderContent() {
  const kw = document.getElementById('search').value.trim().toLowerCase();
  const sec = SECTIONS.find(s => s.key === ACTIVE);
  if (!sec) return;

  let blocks = sec.body;
  if (kw) {
    blocks = blocks.filter(b => JSON.stringify(b).toLowerCase().includes(kw));
    if (!blocks.length) {
      document.getElementById('content').innerHTML =
        '<div class="card"><div class="card-body"><div class="empty-mini">在「' + esc(sec.title) + '」中没有找到匹配「' + esc(kw) + '」的内容</div></div></div>';
      return;
    }
  }

  document.getElementById('content').innerHTML = blocks.map(b => {
    let inner = '';
    if (b.p) inner += '<p style="margin:0 0 12px;line-height:1.8;font-size:13.5px">' + b.p + '</p>';
    if (b.pre) inner += '<pre class="code-block">' + esc(b.pre) + '</pre>';
    if (b.list) inner += '<ul style="margin:0 0 12px;padding-left:22px;line-height:2;font-size:13.5px">' +
      b.list.map(i => '<li>' + i + '</li>').join('') + '</ul>';
    if (b.steps) inner += '<ol style="margin:0 0 12px;padding-left:22px;line-height:2;font-size:13.5px">' +
      b.steps.map(i => '<li>' + i + '</li>').join('') + '</ol>';
    if (b.table) inner += '<div class="table-wrap" style="margin-bottom:12px"><table class="table">' +
      '<thead><tr>' + b.table.head.map(h => '<th>' + h + '</th>').join('') + '</tr></thead>' +
      '<tbody>' + b.table.rows.map(r => '<tr>' + r.map(c => '<td>' + c + '</td>').join('') + '</tr>').join('') +
      '</tbody></table></div>';
    if (b.note) inner += '<div class="alert alert-info" style="font-size:12.5px">' + b.note + '</div>';

    return '<div class="card" style="margin-bottom:16px">' +
      '<div class="card-header"><h3>' + esc(b.h) + '</h3></div>' +
      '<div class="card-body">' + inner + '</div>' +
    '</div>';
  }).join('');
}

document.getElementById('search').addEventListener('input', debounce(renderContent, 300));
renderTabs();
renderContent();
</script>