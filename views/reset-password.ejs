<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - <%= settings.site_name %></title>
  <link rel="stylesheet" href="/public/css/app.css">
  <% if (settings.theme_color && settings.theme_color !== '#3687FF') { %>
  <style>:root { --primary: <%= settings.theme_color %>; }</style>
  <% } %>
</head>
<body class="login-body">
  <div class="login-bg">
    <div class="orb orb1"></div>
    <div class="orb orb2"></div>
    <div class="orb orb3"></div>
    <div class="login-grid"></div>
  </div>

  <div class="login-shell">
    <div class="login-hero">
      <div class="hero-brand">
        <div class="logo"><%= settings.site_logo_text %></div>
        <div>
          <div class="brand-name"><%= settings.site_name %></div>
          <div class="brand-tag"><%= settings.site_subtitle %></div>
        </div>
      </div>

      <h1>设置新密码<br><span class="grad">保护你的账号安全</span></h1>
      <p class="hero-desc">
        请设置一个新的登录密码。<br>
        密码修改成功后，该重置链接将立即失效，同时其他设备的登录状态会被退出。
      </p>

      <div class="hero-features">
        <div class="hero-feature">
          <div class="fi">⛨</div>
          <div>
            <div class="ft">安全存储</div>
            <div class="fd">新密码使用 bcrypt 加密后存储</div>
          </div>
        </div>
        <div class="hero-feature">
          <div class="fi">↻</div>
          <div>
            <div class="ft">会话失效</div>
            <div class="fd">重置后需在所有设备重新登录</div>
          </div>
        </div>
      </div>

      <div class="hero-foot">
        <% if (settings.site_footer) { %><%= settings.site_footer %><br><% } %>
        © <%= new Date().getFullYear() %> <%= settings.site_name %>
      </div>
    </div>

    <div class="login-panel">
      <div class="panel-title">重置密码</div>
      <div class="panel-sub">
        <% if (valid) { %>账号：<b style="color:#73DBFF"><%= username %></b><% } else { %>链接无效<% } %>
      </div>

      <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
      <% } %>

      <% if (valid) { %>
      <form method="post" action="/reset-password" class="login-form">
        <input type="hidden" name="token" value="<%= token %>">

        <label class="field">
          <span>新密码</span>
          <input class="input" type="password" name="newPassword" placeholder="请输入新密码"
                 autocomplete="new-password" required autofocus>
        </label>

        <label class="field">
          <span>确认新密码</span>
          <input class="input" type="password" name="confirmPassword" placeholder="请再次输入新密码"
                 autocomplete="new-password" required>
        </label>

        <button class="btn-login" type="submit">确认重置</button>

        <div class="panel-links" style="justify-content:center">
          <a href="/login">返回登录</a>
        </div>
      </form>
      <% } else { %>
      <div class="panel-links" style="justify-content:center;margin-top:8px">
        <a href="/forgot-password">重新申请重置链接</a>
      </div>
      <% } %>
    </div>
  </div>
</body>
</html>