<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - <%= settings.site_name %></title>
  <link rel="stylesheet" href="/public/css/app.css">
  <% if (settings.theme_color && settings.theme_color !== '#3687FF') { %>
  <style>:root { --primary: <%= settings.theme_color %>; }</style>
  <% } %>
  <style>
    .lg-body {
      min-height: 100vh; display: flex; align-items: center; justify-content: center;
      padding: 24px; position: relative; overflow: hidden;
      background: #FFFFFF;
    }
    .lg-bg { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
    .lg-orb { position: absolute; border-radius: 50%; filter: blur(70px); opacity: .22; }
    .lg-orb.o1 { width: 460px; height: 460px; background: #73DBFF; top: -140px; left: -120px; animation: float1 18s ease-in-out infinite; }
    .lg-orb.o2 { width: 380px; height: 380px; background: #45B4FF; bottom: -120px; right: -100px; animation: float2 22s ease-in-out infinite; }
    .lg-orb.o3 { width: 300px; height: 300px; background: rgba(162,215,60,.30); top: 40%; right: 20%; animation: float1 26s ease-in-out infinite reverse; }
    @keyframes float1 { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(40px,50px) scale(1.08); } }
    @keyframes float2 { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(-50px,-40px) scale(1.1); } }

    .lg-grid {
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(54,135,255,.07) 1px, transparent 1px),
        linear-gradient(90deg, rgba(54,135,255,.07) 1px, transparent 1px);
      background-size: 44px 44px;
      mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, #000000 30%, transparent 75%);
    }

    .lg-shell {
      position: relative; z-index: 2; width: 100%; max-width: 1040px;
      display: grid; grid-template-columns: 1.15fr 1fr;
      background: rgba(255,255,255,.72); backdrop-filter: blur(24px);
      border: 1px solid rgba(255,255,255,.9);
      border-radius: 26px; overflow: hidden;
      box-shadow: 0 30px 80px -20px rgba(45,111,228,.28), 0 0 0 1px rgba(255,255,255,.5) inset;
    }

    /* 左侧品牌区 */
    .lg-hero {
      padding: 52px 46px; position: relative;
      background: linear-gradient(150deg, #003378 0%, #2D6FE4 45%, #3687FF 100%);
      color: #FFFFFF; display: flex; flex-direction: column;
    }
    .lg-hero::after {
      content: ''; position: absolute; inset: 0;
      background-image:
        radial-gradient(circle at 20% 20%, rgba(255,255,255,.14) 0%, transparent 45%),
        radial-gradient(circle at 80% 80%, rgba(255,255,255,.1) 0%, transparent 45%);
      pointer-events: none;
    }
    .lg-hero > * { position: relative; z-index: 1; }

    .lg-brand { display: flex; align-items: center; gap: 13px; margin-bottom: 44px; }
    .lg-brand .mark {
      width: 46px; height: 46px; border-radius: 13px; flex: 0 0 46px;
      background: rgba(255,255,255,.2); border: 1px solid rgba(255,255,255,.35);
      display: flex; align-items: center; justify-content: center;
      font-size: 21px; font-weight: 700; backdrop-filter: blur(8px);
    }
    .lg-brand .bname { font-size: 16px; font-weight: 700; line-height: 1.3; }
    .lg-brand .btag { font-size: 11.5px; opacity: .75; }

    .lg-hero h1 {
      font-size: 30px; line-height: 1.35; margin: 0 0 16px; font-weight: 800;
      letter-spacing: -.5px;
    }
    .lg-hero h1 .hl {
      background: linear-gradient(90deg, #FFFFFF, #73DBFF);
      -webkit-background-clip: text; background-clip: text; color: transparent;
    }
    .lg-hero .desc { font-size: 13.5px; line-height: 1.85; opacity: .88; margin: 0 0 34px; }

    .lg-feats { display: grid; gap: 14px; margin-top: auto; }
    .lg-feat { display: flex; gap: 12px; align-items: flex-start; }
    .lg-feat .fi {
      width: 34px; height: 34px; border-radius: 10px; flex: 0 0 34px;
      background: rgba(255,255,255,.18); border: 1px solid rgba(255,255,255,.28);
      display: flex; align-items: center; justify-content: center; font-size: 15px;
    }
    .lg-feat .ft { font-size: 13px; font-weight: 600; margin-bottom: 2px; }
    .lg-feat .fd { font-size: 11.5px; opacity: .78; line-height: 1.5; }

    /* 右侧表单区 */
    .lg-panel { padding: 52px 46px; display: flex; flex-direction: column; justify-content: center; }
    .lg-panel h2 { font-size: 24px; margin: 0 0 6px; font-weight: 800; color: var(--text); }
    .lg-panel .sub { font-size: 13px; color: var(--text-muted); margin: 0 0 30px; }

    .lg-field { margin-bottom: 18px; }
    .lg-field label {
      display: block; font-size: 12.5px; font-weight: 600;
      color: var(--text-secondary); margin-bottom: 7px;
    }
    .lg-input-wrap { position: relative; }
    .lg-input-wrap .ico {
      position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
      font-size: 15px; color: var(--text-muted); pointer-events: none;
    }
    .lg-input {
      width: 100%; height: 46px; padding: 0 14px 0 42px;
      border: 1.5px solid var(--border); border-radius: 11px;
      font-size: 14px; font-family: inherit; color: var(--text);
      background: var(--surface); transition: all .18s ease; outline: none;
    }
    .lg-input:focus {
      border-color: var(--primary); box-shadow: 0 0 0 4px rgba(54,135,255,.16);
    }
    .lg-input::placeholder { color: var(--text-muted); }

    .lg-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
    .lg-check { display: flex; align-items: center; gap: 7px; font-size: 12.5px; color: var(--text-secondary); cursor: pointer; }
    .lg-check input { width: 15px; height: 15px; accent-color: var(--primary); cursor: pointer; }
    .lg-link { font-size: 12.5px; color: var(--primary-dark); text-decoration: none; font-weight: 500; }
    .lg-link:hover { text-decoration: underline; }

    .lg-btn {
      width: 100%; height: 48px; border: none; border-radius: 11px;
      background: linear-gradient(135deg, #2D6FE4, #3687FF);
      color: #FFFFFF; font-size: 15px; font-weight: 600; font-family: inherit;
      cursor: pointer; transition: all .2s ease;
      box-shadow: 0 8px 22px -6px rgba(45,111,228,.5);
    }
    .lg-btn:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 12px 28px -6px rgba(45,111,228,.6); }
    .lg-btn:active:not(:disabled) { transform: translateY(0); }
    .lg-btn:disabled { opacity: .65; cursor: not-allowed; }

    .lg-alert {
      padding: 11px 14px; border-radius: 10px; font-size: 12.5px;
      margin-bottom: 18px; display: flex; gap: 8px; align-items: flex-start;
    }
    .lg-alert.err { background: var(--danger-bg); color: #003378; border: 1px solid rgba(232,97,97,.55); border-left: 4px solid var(--danger); }
    .lg-alert.ok { background: var(--success-bg); color: #003378; border: 1px solid rgba(162,215,60,.60); border-left: 4px solid var(--success); }

    .lg-foot { margin-top: 26px; text-align: center; font-size: 12px; color: var(--text-muted); }
    .lg-foot a { color: var(--primary-dark); text-decoration: none; font-weight: 500; }

    .lg-divider {
      display: flex; align-items: center; gap: 12px;
      margin: 22px 0; font-size: 11.5px; color: var(--text-muted);
    }
    .lg-divider::before, .lg-divider::after {
      content: ''; flex: 1; height: 1px; background: var(--border);
    }

    @media (max-width: 900px) {
      .lg-shell { grid-template-columns: 1fr; max-width: 440px; }
      .lg-hero { display: none; }
      .lg-panel { padding: 40px 30px; }
    }
  </style>
</head>
<body class="lg-body">
  <div class="lg-bg">
    <div class="lg-orb o1"></div>
    <div class="lg-orb o2"></div>
    <div class="lg-orb o3"></div>
    <div class="lg-grid"></div>
  </div>

  <div class="lg-shell">
    <!-- 左侧品牌区 -->
    <div class="lg-hero">
      <div class="lg-brand">
        <div class="mark"><%= settings.site_logo_text %></div>
        <div>
          <div class="bname"><%= settings.site_name %></div>
          <div class="btag"><%= settings.site_subtitle %></div>
        </div>
      </div>

      <h1>数据集成 · 数据治理<br><span class="hl">报表 BI · AI 问数</span></h1>
      <p class="desc">
        一体化综合数据中台。接入简道云推送、接口采集与表单数据，
        经过清洗加工后生成报表与大屏，并支持 AI 自然语言问数。
      </p>

      <div class="lg-feats">
        <div class="lg-feat">
          <div class="fi">⇣</div>
          <div>
            <div class="ft">多源数据接入</div>
            <div class="fd">简道云推送 · 接口采集 · 表单填写 · 13 种数据库</div>
          </div>
        </div>
        <div class="lg-feat">
          <div class="fi">⚙</div>
          <div>
            <div class="ft">数据清洗加工</div>
            <div class="fd">拖拽编排 24 种节点，过滤、转换、聚合、公式计算</div>
          </div>
        </div>
        <div class="lg-feat">
          <div class="fi">◨</div>
          <div>
            <div class="ft">报表与可视化</div>
            <div class="fd">12 种图表 · 看板大屏 · 外链分享 · 自动刷新</div>
          </div>
        </div>
        <div class="lg-feat">
          <div class="fi">✦</div>
          <div>
            <div class="ft">AI 智能问数</div>
            <div class="fd">自然语言提问，自动生成 SQL 并解读结果</div>
          </div>
        </div>
      </div>
    </div>

    <!-- 右侧表单区 -->
    <div class="lg-panel">
      <h2>欢迎回来</h2>
      <p class="sub">登录 <%= settings.site_name %> 管理你的数据资产</p>

      <% if (error) { %>
      <div class="lg-alert err"><span>⚠</span><span><%= error %></span></div>
      <% } %>
      <% if (info) { %>
      <div class="lg-alert ok"><span>✓</span><span><%= info %></span></div>
      <% } %>

      <form method="post" action="/login" id="loginForm">
        <input type="hidden" name="redirect" value="<%= redirect || '/' %>">

        <div class="lg-field">
          <label for="username">账号</label>
          <div class="lg-input-wrap">
            <span class="ico">◈</span>
            <input class="lg-input" id="username" name="username" type="text"
                   placeholder="请输入账号或邮箱" autocomplete="username" required autofocus>
          </div>
        </div>

        <div class="lg-field">
          <label for="password">密码</label>
          <div class="lg-input-wrap">
            <span class="ico">⌘</span>
            <input class="lg-input" id="password" name="password" type="password"
                   placeholder="请输入密码" autocomplete="current-password" required>
          </div>
        </div>

        <div class="lg-row">
          <label class="lg-check">
            <input type="checkbox" name="remember" value="1">
            <span>记住登录状态</span>
          </label>
          <a class="lg-link" href="/forgot-password">忘记密码？</a>
        </div>

        <button class="lg-btn" type="submit" id="submitBtn">登录</button>
      </form>

      <% if (allowRegistration) { %>
      <div class="lg-divider">还没有账号</div>
      <a class="lg-btn" href="/register"
         style="display:flex;align-items:center;justify-content:center;text-decoration:none;background:var(--surface);color:var(--primary-dark);border:1.5px solid var(--border);box-shadow:none">
        注册新账号
      </a>
      <% } %>

      <div class="lg-foot">
        <% if (settings.site_footer) { %><%= settings.site_footer %><br><% } %>
        <a href="/intro">了解 Neo Zheng DataETL →</a>
      </div>
    </div>
  </div>

  <script>
    document.getElementById('loginForm').addEventListener('submit', function () {
      const btn = document.getElementById('submitBtn');
      btn.disabled = true;
      btn.textContent = '登录中...';
    });
  </script>
</body>
</html>