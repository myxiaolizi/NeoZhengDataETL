<% var body = '' %>
<% body += `
<div class="page-head">
  <div>
    <h1>${esc(project.name)}</h1>
    <p class="sub">
      <code>${esc(project.code)}</code>
      <span class="tag ${project.status ? 'tag-ok' : 'tag-off'}">${project.status ? '启用' : '停用'}</span>
      ${project.jdy_secret ? '<span class="tag tag-ok">Secret 已配置</span>' : '<span class="tag tag-warn">Secret 未配置</span>'}
      ${Number(project.parse_enabled) ? '<span class="tag tag-primary">字段解析开启</span>' : '<span class="tag tag-off">字段解析关闭</span>'}
    </p>
  </div>
  <div class="head-actions">
    ${can('project:write') ? '<button class="btn" onclick="simulate()">模拟推送</button>' : ''}
    <a class="btn" href="/api/projects/${project.id}/export">导出 CSV</a>
    <a class="btn btn-ghost" href="/projects">返回列表</a>
  </div>
</div>

<div class="stat-row">
  <div class="stat"><div class="stat-label">数据总条数</div><div class="stat-value" id="s_total">-</div></div>
  <div class="stat"><div class="stat-label">今日新增</div><div class="stat-value" id="s_today">-</div></div>
  <div class="stat"><div class="stat-label">字段定义</div><div class="stat-value" id="s_fields">-</div></div>
  <div class="stat"><div class="stat-label">数据列数</div><div class="stat-value" id="s_cols">-</div></div>
  <div class="stat"><div class="stat-label">接收日志</div><div class="stat-value" id="s_logs">-</div></div>
  <div class="stat"><div class="stat-label">失败日志</div><div class="stat-value" id="s_fail">-</div></div>
</div>

<div class="card">
  <div class="tabs">
    <button class="tab active" data-tab="home" onclick="switchTab('home')">项目首页</button>
    <button class="tab" data-tab="records" onclick="switchTab('records')">原始数据</button>
    <button class="tab" data-tab="parsed" onclick="switchTab('parsed')">解析后数据</button>
    <button class="tab" data-tab="logs" onclick="switchTab('logs')">接收日志</button>
    <button class="tab" data-tab="fields" onclick="switchTab('fields')">字段结构</button>
    <button class="tab" data-tab="sub" onclick="switchTab('sub')">子表数据</button>
    <button class="tab" data-tab="settings" onclick="switchTab('settings')">字段设置</button>
  </div>

  <!-- ══════════ 项目首页 ══════════ -->
  <div class="tab-panel" id="panel-home">
    <div class="toolbar" style="border-top:none">
      <span class="muted small">项目配置、推送地址与数据表信息</span>
      <div class="spacer"></div>
      <span class="tag tag-off" id="homeMode">只读</span>
      ${can('project:write') ? '<button class="btn btn-primary btn-sm" id="homeEditBtn" onclick="toggleHomeEdit()">修改</button>' : ''}
    </div>

    <div class="card-body" style="padding-top:4px">
      <!-- 推送地址 -->
      <div class="home-section">
        <div class="home-section-title">
          <span class="hs-ico">⇣</span> 推送地址
          <span class="muted small">把该地址填入简道云等第三方应用的「数据推送 / Webhook」配置中</span>
        </div>
        <div class="url-box">
          <code id="pushUrlText">-</code>
          <button class="btn btn-sm" onclick="copyPushUrl()">复制</button>
          <button class="btn btn-sm" onclick="openPushInfo()">配置说明</button>
        </div>
        <div class="kv" style="margin-top:12px">
          <div><span>请求方法</span><code>POST</code></div>
          <div><span>内容类型</span><code>application/json</code></div>
          <div><span>签名算法</span><code>sha1("{nonce}:{payload}:{secret}:{timestamp}")</code></div>
          <div><span>签名请求头</span><code>X-JDY-Signature</code></div>
        </div>
      </div>

      <!-- 数据表信息 -->
      <div class="home-section">
        <div class="home-section-title">
          <span class="hs-ico">⛁</span> 数据表信息
          <span class="muted small">每个项目独立一套数据表，解析前后分离存储</span>
        </div>
        <div class="kv">
          <div><span>存储数据源</span>
            <b>${esc(project.datasource_name || '本机数据库')}</b>
            <span class="tag tag-primary tag-sm">${esc(project.datasource_type || 'mysql')}</span>
          </div>
          <div><span>原始数据表</span><code>${esc(project.data_table || '-')}</code>
            <button class="btn btn-sm" data-copy="${esc(project.data_table || '')}">复制</button></div>
          <div><span>解析数据表</span><code>${esc(project.parsed_table || '-')}</code>
            <button class="btn btn-sm" data-copy="${esc(project.parsed_table || '')}">复制</button></div>
          <div><span>接收日志表</span><code>${esc(project.log_table || '-')}</code></div>
        </div>
      </div>

      <!-- 项目设置 -->
      <div class="home-section">
        <div class="home-section-title">
          <span class="hs-ico">⚙</span> 项目设置
          <span class="muted small">点击右上角「修改」后可编辑</span>
        </div>
        <div id="homeView">
          <div class="kv">
            <div><span>项目名称</span><b>${esc(project.name)}</b></div>
            <div><span>项目编码</span><code>${esc(project.code)}</code></div>
            <div><span>项目分类</span>${project.category ? esc(project.category) : '<span class="muted">未设置</span>'}</div>
            <div><span>Secret</span>${project.jdy_secret ? '<span class="tag tag-ok tag-sm">已配置</span>' : '<span class="tag tag-warn tag-sm">未配置</span>'}</div>
            <div><span>字段解析</span>${Number(project.parse_enabled) ? '<span class="tag tag-ok tag-sm">开启</span>' : '<span class="tag tag-off tag-sm">关闭</span>'}</div>
            <div><span>项目状态</span>${project.status ? '<span class="tag tag-ok tag-sm">启用</span>' : '<span class="tag tag-off tag-sm">停用</span>'}</div>
            <div><span>项目说明</span>${project.description ? esc(project.description) : '<span class="muted">暂无</span>'}</div>
            <div><span>备注</span>${project.remark ? esc(project.remark) : '<span class="muted">暂无</span>'}</div>
            <div><span>创建时间</span>${fmtTime(project.created_at)}</div>
            <div><span>最近推送</span>${fmtTime(project.last_push_at)}</div>
          </div>
        </div>

        <div id="homeEdit" class="hidden">
          <div class="form-row">
            <label class="field">
              <span>项目名称 <i class="req">*</i></span>
              <input class="input" id="h_name" value="${esc(project.name)}">
            </label>
            <label class="field">
              <span>项目分类</span>
              <input class="input" id="h_category" value="${esc(project.category || '')}" placeholder="例如：客户管理">
            </label>
          </div>
          <div class="form-row">
            <label class="field">
              <span>Secret</span>
              <input class="input" id="h_secret" value="${esc(project.jdy_secret || '')}" placeholder="简道云生成的 Secret">
              <small class="hint">用于校验推送签名，留空表示不校验</small>
            </label>
            <label class="field">
              <span>存储数据源</span>
              <select class="input" id="h_datasource"><option value="0">本机数据库</option></select>
              <small class="hint">项目已有数据时无法切换数据源</small>
            </label>
          </div>
          <div class="form-row">
            <label class="field">
              <span>字段解析</span>
              <label class="switch">
                <input type="checkbox" id="h_parse" ${Number(project.parse_enabled) ? 'checked' : ''}>
                <span class="track"></span>
                <span class="label-text">开启后 JSON 字段自动解析为可读值</span>
              </label>
            </label>
            <label class="field">
              <span>项目状态</span>
              <label class="switch">
                <input type="checkbox" id="h_status" ${project.status ? 'checked' : ''}>
                <span class="track"></span>
                <span class="label-text">启用该项目</span>
              </label>
            </label>
          </div>
          <label class="field">
            <span>项目说明</span>
            <textarea class="input" id="h_desc" rows="2">${esc(project.description || '')}</textarea>
          </label>
          <label class="field">
            <span>备注</span>
            <textarea class="input" id="h_remark" rows="2">${esc(project.remark || '')}</textarea>
          </label>
          <div class="form-actions">
            <button class="btn btn-primary" onclick="saveHome()">保存修改</button>
            <button class="btn btn-ghost" onclick="toggleHomeEdit(false)">取消</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="tab-panel hidden" id="panel-records">
    <div class="toolbar">
      <select class="input" id="r_field" style="width:200px" onchange="loadRecords(1)">
        <option value="">全部字段</option>
      </select>
      <input class="input" id="r_kw" placeholder="搜索内容" style="width:240px">
      <select class="input" id="r_op" style="width:150px">
        <option value="">全部事件</option>
        <option value="data_create">数据提交</option>
        <option value="data_update">数据修改</option>
        <option value="data_recover">数据恢复</option>
        <option value="task_update">流程待办变更</option>
        <option value="flow_state_change">流程状态变更</option>
        <option value="flow_instance_create">流程发起</option>
        <option value="flow_instance_finish">流程完成</option>
        <option value="cc_create">产生抄送</option>
      </select>
      <button class="btn btn-primary" onclick="loadRecords(1)">查询</button>
      <button class="btn" onclick="resetRecordFilter()">重置</button>
      <button class="btn" onclick="toggleColMenu('records')">列设置</button>
      <div class="spacer"></div>
      <span class="muted small" id="r_count"></span>
      <div class="col-menu hidden" id="r_colMenu"></div>
    </div>
    <div class="table-wrap">
      <table class="table table-fixed" id="recordTable">
        <thead id="recordHead"></thead>
        <tbody id="recordBody"><tr><td class="empty">加载中...</td></tr></tbody>
      </table>
    </div>
    <div class="pager" id="recordPager"></div>
  </div>

  <div class="tab-panel hidden" id="panel-parsed">
    <div class="toolbar">
      <span class="muted small">
        解析后数据表 <code>${esc(project.parsed_table || '-')}</code> —— 存放加工后的可读值
      </span>
      <div class="spacer"></div>
      <select class="input" id="p_field" style="width:200px" onchange="loadParsed(1)">
        <option value="">全部字段</option>
      </select>
      <input class="input" id="p_kw" placeholder="搜索内容" style="width:220px">
      <button class="btn btn-primary" onclick="loadParsed(1)">查询</button>
      <button class="btn" onclick="resetParsedFilter()">重置</button>
      <button class="btn" onclick="toggleColMenu('parsed')">列设置</button>
      <div class="spacer"></div>
      <span class="muted small" id="p_count"></span>
      <div class="col-menu hidden" id="p_colMenu"></div>
    </div>
    <div class="table-wrap">
      <table class="table table-fixed">
        <thead id="parsedHead"></thead>
        <tbody id="parsedBody"><tr><td class="empty">加载中...</td></tr></tbody>
      </table>
    </div>
    <div class="pager" id="parsedPager"></div>
  </div>

  <div class="tab-panel hidden" id="panel-logs">
    <div class="toolbar">
      <input class="input" id="l_kw" placeholder="搜索数据ID / 表单名称 / 消息" style="width:260px">
      <select class="input" id="l_op" style="width:180px"><option value="">全部事件</option></select>
      <select class="input" id="l_result" style="width:160px">
        <option value="">全部结果</option>
        <option value="success">成功</option>
        <option value="error">失败</option>
        <option value="signature_failed">签名校验失败</option>
      </select>
      <button class="btn btn-primary" onclick="loadLogs(1)">查询</button>
      <div class="spacer"></div>
      ${can('log:clear') ? '<button class="btn btn-danger btn-sm" onclick="clearLogs()">清空日志</button>' : ''}
      <span class="muted small" id="l_count"></span>
    </div>
    <div class="table-wrap">
      <table class="table table-fixed">
        <thead>
          <tr>
            <th style="width:70px">ID</th>
            <th style="width:130px">事件</th>
            <th style="width:160px">数据ID</th>
            <th style="width:150px">表单名称</th>
            <th>变更摘要</th>
            <th style="width:70px">字段数</th>
            <th style="width:100px">签名</th>
            <th style="width:80px">结果</th>
            <th>消息</th>
            <th style="width:150px">接收时间</th>
            <th style="width:70px">详情</th>
          </tr>
        </thead>
        <tbody id="logBody"><tr><td colspan="11" class="empty">加载中...</td></tr></tbody>
      </table>
    </div>
    <div class="pager" id="logPager"></div>
  </div>

  <div class="tab-panel hidden" id="panel-fields">
    <div class="toolbar">
      <span class="muted small">数据列以简道云「字段名称」作为注释；带 <span class="tag tag-primary tag-sm">解析</span> 标记的列存放加工后的可读值；<span class="tag tag-warn tag-sm">空列</span> 表示该列尚无数据（历史遗留列，可忽略）</span>
      <div class="spacer"></div>
      ${can('field:write') ? '<button class="btn btn-sm" onclick="switchTab(\'settings\')">前往字段设置</button>' : ''}
    </div>
    <div class="table-wrap">
      <table class="table table-fixed">
        <thead>
          <tr>
            <th style="width:60px">#</th>
            <th style="width:220px">数据库列名</th>
            <th style="width:240px">字段名称（列注释）</th>
            <th style="width:150px">列类型</th>
            <th style="width:110px">类型</th>
            <th style="width:120px">数据</th>
            <th>说明</th>
          </tr>
        </thead>
        <tbody id="fieldBody"><tr><td colspan="7" class="empty">加载中...</td></tr></tbody>
      </table>
    </div>
  </div>

  <div class="tab-panel hidden" id="panel-sub">
    <div class="toolbar">
      <select class="input" id="sub_table" style="width:320px" onchange="loadSubRows(1)"></select>
      <button class="btn btn-primary" onclick="loadSubRows(1)">查询</button>
      <div class="spacer"></div>
      <span class="muted small" id="sub_count"></span>
    </div>
    <div class="table-wrap">
      <table class="table table-fixed" id="subTable">
        <thead id="subHead"></thead>
        <tbody id="subBody"><tr><td class="empty">请选择子表</td></tr></tbody>
      </table>
    </div>
    <div class="pager" id="subPager"></div>
  </div>

  <!-- ══════════ 字段设置 ══════════ -->
  <div class="tab-panel hidden" id="panel-settings">
    <div class="toolbar" style="border-top:none">
      <span class="muted small">字段定义 ↔ 数据库列一一对应；解析方式可直接在行内修改并立即生效</span>
      <div class="spacer"></div>
      ${can('field:write') ? '<button class="btn btn-sm btn-primary" onclick="toggleFieldImport()">导入字段表</button>' : ''}
      ${can('field:write') ? '<button class="btn btn-sm" onclick="syncFields()">同步表结构</button>' : ''}
      <button class="btn btn-sm" onclick="loadFieldSettings()">刷新</button>
    </div>

    <!-- 内嵌导入区：在当前标签页内完成，不跳页、不弹窗 -->
    <div class="field-import hidden" id="fieldImportBox">
      <div class="fi-head">
        <b>导入简道云字段表</b>
        <span class="muted small">支持 Markdown 表格 / 网页复制 / Excel 粘贴；单元格内的换行与 JSON 样例会自动合并</span>
        <div class="spacer"></div>
        <button class="btn btn-sm btn-ghost" onclick="toggleFieldImport(false)">收起</button>
      </div>
      <textarea class="input mono" id="fieldImportText" rows="7"
        placeholder="|字段名称|字段ID/字段别名|字段类型|说明|&#10;|---|---|---|---|&#10;|表单名称|formName|string||&#10;|销售|_widget_1791449342208|json|status -1 表示离职；0 表示未加入；1 表示已加入|"></textarea>
      <div class="fi-actions">
        <button class="btn btn-sm" onclick="parseFieldPreview()">解析预览</button>
        <label class="switch">
          <input type="checkbox" id="fieldImportReplace" checked>
          <span class="track"></span>
          <span class="label-text">覆盖已有字段定义</span>
        </label>
        <button class="btn btn-sm btn-primary" id="fieldImportBtn" onclick="doFieldImport()" disabled>确认导入</button>
        <span class="muted small" id="fieldImportInfo"></span>
      </div>
      <div class="fi-preview hidden" id="fieldPreviewWrap">
        <table class="table">
          <thead>
            <tr>
              <th style="width:44px">#</th>
              <th style="width:170px">字段名称</th>
              <th style="width:190px">字段ID</th>
              <th style="width:80px">类型</th>
              <th style="width:150px">数据库列名</th>
              <th style="width:120px">解析方式</th>
              <th>状态</th>
            </tr>
          </thead>
          <tbody id="fieldPreviewBody"></tbody>
        </table>
      </div>
    </div>

    <div class="toolbar">
      <input class="input" id="fs_kw" placeholder="搜索字段名称 / 字段ID / 列名" style="width:240px">
      <select class="input" id="fs_mode" style="width:160px">
        <option value="">全部解析方式</option>
      </select>
      <select class="input" id="fs_state" style="width:150px">
        <option value="">全部状态</option>
        <option value="missing">未建列</option>
        <option value="empty">列内无数据</option>
        <option value="ok">列内已有数据</option>
      </select>
      <div class="spacer"></div>
      <span class="muted small" id="fs_stat"></span>
    </div>

    <div class="table-wrap">
      <table class="table table-fixed">
        <thead>
          <tr>
            <th style="width:52px">#</th>
            <th style="width:170px">字段名称</th>
            <th style="width:186px">字段ID</th>
            <th style="width:180px">数据库列名</th>
            <th style="width:170px">解析方式</th>
            <th>说明 / 解析路径</th>
            <th style="width:78px">启用</th>
            <th style="width:96px">操作</th>
          </tr>
        </thead>
        <tbody id="fieldSetBody"><tr><td colspan="8" class="empty">加载中...</td></tr></tbody>
      </table>
    </div>
    <div class="pager" id="fieldSetPager"></div>
  </div>
</div>

<div class="modal-mask" id="pushModal">
  <div class="modal modal-wide">
    <div class="modal-head">
      <h3>简道云推送配置</h3>
      <button class="modal-close" onclick="closeModal('pushModal')">×</button>
    </div>
    <div class="modal-body">
      <div class="alert alert-info">
        在简道云「扩展功能 → 数据推送 → 新建数据推送」中，目标服务器选择「<b>自定义服务器</b>」，
        把下面的地址填入「服务器地址」，然后点击「生成 Secret」并把 Secret 回填到本项目。
      </div>
      <label class="field">
        <span>推送地址（填入简道云「服务器地址」）</span>
        <div class="copy-row">
          <input class="input mono" id="pushUrl" readonly>
          <button class="btn" onclick="copyText(document.getElementById('pushUrl').value)">复制</button>
        </div>
      </label>
      ${can('project:write') ? `
      <label class="field">
        <span>Secret（简道云「生成 Secret」后复制并粘贴到下方保存）</span>
        <div class="copy-row">
          <input class="input mono" id="pushSecret" placeholder="粘贴简道云生成的 Secret">
          <button class="btn btn-primary" onclick="saveSecret()">保存 Secret</button>
        </div>
      </label>` : ''}
      <div class="kv">
        <div><span>数据表</span><code>${esc(project.data_table)}</code></div>
        <div><span>日志表</span><code>${esc(project.log_table)}</code></div>
      </div>
      <details class="details">
        <summary>签名校验算法（简道云开发指南）</summary>
        <pre class="pre">signature = sha1( "{nonce}:{payload}:{secret}:{timestamp}" )
payload   = HTTP 请求体原始字符串
nonce     = URL 查询参数 nonce
timestamp = URL 查询参数 timestamp
比较对象   = 请求头 X-JDY-Signature（十六进制小写）
请求头 X-JDY-DeliverId 为每次推送的唯一 ID，可用于去重</pre>
      </details>
    </div>
    <div class="modal-foot">
      <button class="btn btn-ghost" onclick="closeModal('pushModal')">关闭</button>
    </div>
  </div>
</div>

<div class="modal-mask" id="fieldEditModal">
  <div class="modal">
    <div class="modal-head">
      <h3>编辑字段</h3>
      <button class="modal-close" onclick="closeModal('fieldEditModal')">×</button>
    </div>
    <div class="modal-body" id="fieldEditBody"></div>
    <div class="modal-foot">
      <button class="btn btn-ghost" onclick="closeModal('fieldEditModal')">取消</button>
      <button class="btn btn-primary" id="fieldEditSave">保存</button>
    </div>
  </div>
</div>

${can('project:write') ? `
<div class="modal-mask" id="settingModal">
  <div class="modal">
    <div class="modal-head">
      <h3>项目设置</h3>
      <button class="modal-close" onclick="closeModal('settingModal')">×</button>
    </div>
    <div class="modal-body">
      <label class="field"><span>项目名称</span><input class="input" id="s_name"></label>
      <label class="field"><span>简道云服务器地址</span><input class="input" id="s_base"></label>
      <label class="field"><span>Secret</span><input class="input" id="s_secret"></label>
      <label class="field"><span>状态</span>
        <select class="input" id="s_status"><option value="1">启用</option><option value="0">停用</option></select>
      </label>
      <label class="field">
        <span>字段自动解析</span>
        <label class="switch">
          <input type="checkbox" id="s_parse">
          <span class="track"></span>
          <span class="label-text">开启后 JSON 结构字段自动解析为可读值</span>
        </label>
      </label>
      <label class="field">
        <span>数据ID 展示字段</span>
        <select class="input" id="s_idfield"><option value="">默认（简道云 _id）</option></select>
        <small class="hint">选择业务字段（如「流水号」）后，列表、搜索、导出都用该字段值替代简道云 _id 作为数据标识。</small>
      </label>
      <label class="field"><span>项目说明</span><textarea class="input" id="s_desc" rows="2"></textarea></label>
      <label class="field"><span>备注</span><textarea class="input" id="s_remark" rows="2"></textarea></label>
      <hr>
      <div class="danger-zone">
        <div>
          <strong>重新生成推送令牌</strong>
          <p class="muted small">生成后旧推送地址立即失效，需要同步更新简道云中的服务器地址。</p>
        </div>
        <button class="btn" onclick="regenToken()">重新生成</button>
      </div>
      <div class="danger-zone">
        <div>
          <strong>删除项目</strong>
          <p class="muted small">将同时删除数据表、日志表、子表与字段定义，不可恢复。</p>
        </div>
        <button class="btn btn-danger" onclick="delProject()">删除项目</button>
      </div>
    </div>
    <div class="modal-foot">
      <button class="btn btn-ghost" onclick="closeModal('settingModal')">取消</button>
      <button class="btn btn-primary" onclick="saveSetting()">保存</button>
    </div>
  </div>
</div>` : ''}

<div class="modal-mask" id="logModal">
  <div class="modal modal-wide">
    <div class="modal-head">
      <h3>推送详情</h3>
      <button class="modal-close" onclick="closeModal('logModal')">×</button>
    </div>
    <div class="modal-body" id="logDetail"></div>
    <div class="modal-foot">
      <button class="btn btn-ghost" onclick="closeModal('logModal')">关闭</button>
    </div>
  </div>
</div>

<div class="modal-mask" id="recordModal">
  <div class="modal modal-wide">
    <div class="modal-head">
      <h3>数据详情</h3>
      <button class="modal-close" onclick="closeModal('recordModal')">×</button>
    </div>
    <div class="modal-body" id="recordDetail"></div>
    <div class="modal-foot">
      <button class="btn btn-ghost" onclick="closeModal('recordModal')">关闭</button>
