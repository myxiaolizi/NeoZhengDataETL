/* ---- 解析后数据 ---- */
async function loadParsed(page) {
  const kw = document.getElementById('p_kw').value.trim();
  const pField = document.getElementById('p_field');
  const field = pField ? pField.value : '';
  const sort = SORT_STATE.parsed;
  const q = 'page=' + page + '&pageSize=20&keyword=' + encodeURIComponent(kw) +
            '&field=' + encodeURIComponent(field) +
            '&sort=' + encodeURIComponent(sort.key) + '&dir=' + sort.dir;
  const r = await api('/api/projects/' + PID + '/parsed?' + q);
  if (!r.ok) return toast(r.message, 'error');

  const idFieldP = r.data.idField || {};
  const idColP = idFieldP.column || null;
  let cols = (r.data.columns || []).filter(c => {
    if (['raw_json','updated_at'].includes(c.name)) return false;
    if (idColP && c.name === 'jdy_data_id') return false;
    return true;
  });
  // 数据ID 来源字段置顶并标注为「数据ID」
  if (idColP) {
    const i = cols.findIndex(c => c.name === idColP);
    if (i > 0) {
      const picked = cols.splice(i, 1)[0];
      cols.unshift(Object.assign({}, picked, { comment: idFieldP.label || '数据ID' }));
    } else if (i === 0) {
      cols[0] = Object.assign({}, cols[0], { comment: idFieldP.label || '数据ID' });
    }
  }
  buildParsedFieldFilter(cols);
  renderColMenu('parsed', cols);
  cols = cols.filter(c => !HIDDEN_COLS.parsed.has(c.name));

  const pHead = document.getElementById('parsedHead');
  pHead.innerHTML = '<tr>' +
    cols.map(c => sortableTh('parsed', c)).join('') +
    '</tr>';
  bindSortHeaders(pHead);

  const body = document.getElementById('parsedBody');
  if (!r.data.list.length) {
    body.innerHTML = '<tr><td colspan="' + Math.max(1, cols.length) + '" class="empty">暂无解析数据，等待推送或点击「字段设置 → 同步表结构」回填</td></tr>';
  } else {
    body.innerHTML = r.data.list.map(row => '<tr>' +
      cols.map(c => {
        let v = row[c.name];
        if (c.name === 'jdy_op') v = OP_LABEL[v] || v;
        if (c.name === 'received_at') v = fmtTime(v);
        if (c.name === 'jdy_op_time') v = fmtTime(v ? Number(v) : null);
        const title = typeof v === 'object' ? JSON.stringify(v) : (v === null || v === undefined ? '' : v);
        return '<td title="' + esc(title) + '"><span class="cell-inner">' + renderCell(v) + '</span></td>';
      }).join('') +
    '</tr>').join('');
  }
  document.getElementById('p_count').textContent = '共 ' + r.data.total + ' 条';
  renderPager('parsedPager', r.data.total, r.data.page, r.data.pageSize, loadParsed);
}

/** 解析表字段下拉（筛选用） */
function buildParsedFieldFilter(cols) {
  const sel = document.getElementById('p_field');
  if (!sel) return;
  const cur = sel.value;
  const list = (cols || []).filter(c => !['raw_json', 'updated_at'].includes(c.name));
  sel.innerHTML = '<option value="">全部字段</option>' + list.map(c =>
    '<option value="' + esc(c.name) + '">' + esc(c.comment || c.name) + '</option>').join('');
  if (list.some(c => c.name === cur)) sel.value = cur;
}

function resetParsedFilter() {
  const kw = document.getElementById('p_kw');
  const f = document.getElementById('p_field');
  if (kw) kw.value = '';
  if (f) f.value = '';
  SORT_STATE.parsed = { key: '', dir: 'desc' };
  loadParsed(1);
}

/* ══════════ 字段设置（全部在当前标签页内完成） ══════════ */

const PARSE_MODES = [
  { key: 'none', name: '不解析' },
  { key: 'name', name: '取名称' },
  { key: 'member_full', name: '成员完整信息' },
  { key: 'username', name: '取账号' },
  { key: 'phone', name: '取手机号' },
  { key: 'id', name: '取关联数据ID' },
  { key: 'text', name: '取文本值' },
  { key: 'address', name: '地址拼接' },
  { key: 'timestamp', name: '时间格式化' },
  { key: 'array_join', name: '数组拼接' },
  { key: 'array_names', name: '数组取名称' },
  { key: 'array_count', name: '数组计数' },
  { key: 'path', name: '自定义路径' },
  { key: 'expand', name: '展开为子表' },
];

let FIELD_DEFS = [];
let FIELD_COLS = [];
const FIELD_PAGE_SIZE = 50;
let FIELD_PAGE = 1;
let FIELD_STATS = {};
let FIELD_PREVIEW = null;

function modeLabel(key) {
  const m = PARSE_MODES.find(x => x.key === key);
  return m ? m.name : (key || '不解析');
}

function modeOptions(cur) {
  return PARSE_MODES.map(m =>
    '<option value="' + m.key + '"' + (m.key === cur ? ' selected' : '') + '>' + m.name + '</option>'
  ).join('');
}

function toggleFieldImport(force) {
  const box = document.getElementById('fieldImportBox');
  if (!box) return;
  const show = force === undefined ? box.classList.contains('hidden') : !!force;
  box.classList.toggle('hidden', !show);
  if (show) {
    const ta = document.getElementById('fieldImportText');
    if (ta) ta.focus();
  }
}

async function loadFieldSettings() {
  const body = document.getElementById('fieldSetBody');
  if (!body) return;
  body.innerHTML = '<tr><td colspan="8" class="empty">加载中...</td></tr>';

  const r = await api('/api/projects/' + PID + '/fields');
  if (!r.ok) {
    body.innerHTML = '<tr><td colspan="8" class="empty">' + esc(r.message) + '</td></tr>';
    return;
  }

  FIELD_DEFS = r.data.fieldDefs || [];
  FIELD_COLS = r.data.columns || [];
  FIELD_STATS = r.data.stats || {};

  renderFieldSettings();
  buildModeFilter();
}

function buildModeFilter() {
  const sel = document.getElementById('fs_mode');
  if (!sel) return;
  const cur = sel.value;
  sel.innerHTML = '<option value="">全部解析方式</option>' + PARSE_MODES.map(m =>
    '<option value="' + m.key + '">' + m.name + '</option>').join('');
  sel.value = cur;
}

function renderFieldSettings() {
  const body = document.getElementById('fieldSetBody');
  if (!body) return;

  const kw = (document.getElementById('fs_kw').value || '').trim().toLowerCase();
  const fm = document.getElementById('fs_mode').value;
  const fs = document.getElementById('fs_state').value;
  const colSet = new Set(FIELD_COLS.map(c => c.name));

  const list = FIELD_DEFS.filter(d => {
    if (fm && d.parse_mode !== fm) return false;
    if (kw) {
      const hay = [d.field_name, d.field_key, d.column_name, d.remark]
        .filter(Boolean).join(' ').toLowerCase();
      if (!hay.includes(kw)) return false;
    }
    if (fs) {
      const exists = colSet.has(d.column_name);
      if (fs === 'missing' && exists) return false;
      if (fs === 'empty' && (!exists || Number(d.rows || 0) > 0)) return false;
      if (fs === 'ok' && (!exists || Number(d.rows || 0) === 0)) return false;
    }
    return true;
  });

  // 分页：字段过多时翻页查看，页面本身不出现滚动条
  const totalPages = Math.max(1, Math.ceil(list.length / FIELD_PAGE_SIZE));
  if (FIELD_PAGE > totalPages) FIELD_PAGE = totalPages;
  if (FIELD_PAGE < 1) FIELD_PAGE = 1;
  const pageStart = (FIELD_PAGE - 1) * FIELD_PAGE_SIZE;
  const pageList = list.slice(pageStart, pageStart + FIELD_PAGE_SIZE);

  if (!FIELD_DEFS.length) {
    body.innerHTML = '<tr><td colspan="8" class="empty">暂无字段定义，请点「导入字段表」或在下方粘贴简道云字段表</td></tr>';
  } else if (!list.length) {
    body.innerHTML = '<tr><td colspan="8" class="empty">没有符合筛选条件的字段</td></tr>';
  } else {
    body.innerHTML = pageList.map((f, i) => {
      const exists = colSet.has(f.column_name);
      const rows = Number(f.rows || 0);
      const parseOn = f.parse_mode && f.parse_mode !== 'none';

      let colCell = '<code class="mini">' + esc(f.column_name || '-') + '</code>';
      if (!exists) colCell += ' <span class="tag tag-err tag-sm">未建列</span>';
      else if (rows > 0) colCell += ' <span class="tag tag-ok tag-sm">' + rows + ' 行</span>';
      else colCell += ' <span class="tag tag-warn tag-sm">空列</span>';

      return '<tr>' +
        '<td>' + (pageStart + i + 1) + '</td>' +
        '<td><b>' + esc(f.field_name || '-') + '</b>' +
          (Number(f.is_system) ? ' <span class="tag tag-off tag-sm">系统</span>' : '') + '</td>' +
        '<td><code class="mini">' + esc(f.field_key || '-') + '</code></td>' +
        '<td>' + colCell + '</td>' +
        '<td>' + (CAN_FIELD_WRITE
          ? '<select class="input input-sm" data-fmode="' + esc(f.field_key) + '">' + modeOptions(f.parse_mode) + '</select>'
          : '<span class="tag ' + (parseOn ? 'tag-primary' : 'tag-off') + ' tag-sm">' + esc(modeLabel(f.parse_mode)) + '</span>') + '</td>' +
        '<td class="small muted" title="' + esc(f.remark || '') + '">' +
          esc(f.parse_path || f.remark || '-') + '</td>' +
        '<td>' + (CAN_FIELD_WRITE
          ? '<label class="switch switch-sm"><input type="checkbox" data-fen="' + esc(f.field_key) + '"' +
            (Number(f.enabled) !== 0 ? ' checked' : '') + '><span class="track"></span></label>'
          : (Number(f.enabled) !== 0 ? '<span class="tag tag-ok tag-sm">启用</span>' : '<span class="tag tag-off tag-sm">停用</span>')) + '</td>' +
        '<td>' + (CAN_FIELD_WRITE
          ? '<button class="btn btn-sm" data-fedit="' + esc(f.field_key) + '">编辑</button>'
          : '') + '</td>' +
      '</tr>';
    }).join('');
  }

  const total = FIELD_DEFS.length;
  const withData = FIELD_DEFS.filter(d => colSet.has(d.column_name) && Number(d.rows || 0) > 0).length;
  const missing = FIELD_DEFS.filter(d => !colSet.has(d.column_name)).length;
  const stat = document.getElementById('fs_stat');
  if (stat) {
    stat.textContent = '共 ' + total + ' 个字段 · 有数据 ' + withData +
      (missing ? ' · 未建列 ' + missing : '') + (list.length !== total ? ' · 已筛出 ' + list.length : '');
  }

  renderPager('fieldSetPager', list.length, FIELD_PAGE, FIELD_PAGE_SIZE, (p) => {
    FIELD_PAGE = p;
    renderFieldSettings();
  });

  // 行内解析方式：改动即保存
  body.querySelectorAll('select[data-fmode]').forEach(sel => {
    sel.addEventListener('change', async () => {
      const key = sel.dataset.fmode;
      const val = sel.value;
      sel.disabled = true;
      const r2 = await api('/api/projects/' + PID + '/fields/' + encodeURIComponent(key), {
        method: 'PUT', body: { parseMode: val },
      });
      sel.disabled = false;
      if (!r2.ok) return toast(r2.message || '保存失败', 'error');
      const d = FIELD_DEFS.find(x => x.field_key === key);
      if (d) d.parse_mode = val;
      toast('已设为「' + modeLabel(val) + '」，点「同步表结构」可回填历史数据', 'success');
    });
  });

  // 行内启用开关
  body.querySelectorAll('input[data-fen]').forEach(chk => {
    chk.addEventListener('change', async () => {
      const key = chk.dataset.fen;
      const r2 = await api('/api/projects/' + PID + '/fields/' + encodeURIComponent(key), {
        method: 'PUT', body: { enabled: chk.checked },
      });
      if (!r2.ok) { chk.checked = !chk.checked; return toast(r2.message || '保存失败', 'error'); }
      const d = FIELD_DEFS.find(x => x.field_key === key);
      if (d) d.enabled = chk.checked ? 1 : 0;
      toast(chk.checked ? '已启用' : '已停用', 'success');
    });
  });

  body.querySelectorAll('button[data-fedit]').forEach(b => {
    b.addEventListener('click', () => editFieldSetting(b.dataset.fedit));
  });
}

/* ---- 导入（当前标签页内联） ---- */
async function parseFieldPreview() {
  const text = document.getElementById('fieldImportText').value;
  if (!text.trim()) return toast('请先粘贴字段表格内容', 'error');

  const r = await api('/api/projects/' + PID + '/fields/parse', { method: 'POST', body: { text } });
  if (!r.ok) return toast(r.message, 'error');

  FIELD_PREVIEW = r.data;
  const list = r.data.fields || [];

  document.getElementById('fieldPreviewBody').innerHTML = list.map((f, i) => {
    const status = f.exists
      ? (Number(f.rows || 0) > 0
        ? '<span class="tag tag-ok tag-sm">复用 ' + f.rows + ' 行</span>'
        : '<span class="tag tag-warn tag-sm">复用空列</span>')
      : '<span class="tag tag-primary tag-sm">新建</span>';
    return '<tr>' +
      '<td>' + (i + 1) + '</td>' +
      '<td>' + esc(f.fieldName) + '</td>' +
      '<td><code class="mini">' + esc(f.fieldKey) + '</code></td>' +
      '<td>' + esc(f.fieldType) + '</td>' +
      '<td><code class="mini">' + esc(f.columnName) + '</code></td>' +
      '<td>' + esc(modeLabel(f.parseMode)) + '</td>' +
      '<td>' + status + '</td>' +
    '</tr>';
  }).join('');

  document.getElementById('fieldPreviewWrap').classList.remove('hidden');
  const warn = (r.data.warnings && r.data.warnings.length) ? '，' + r.data.warnings[0] : '';
  document.getElementById('fieldImportInfo').textContent =
    '共解析 ' + r.data.total + ' 个字段（系统字段 ' + r.data.systemCount +
    ' 个，需新建列 ' + r.data.newCount + ' 个，跳过 ' + r.data.skipped + ' 行）' + warn;
  document.getElementById('fieldImportBtn').disabled = false;

  if (r.data.errors && r.data.errors.length) toast(r.data.errors[0], 'error');
}

async function doFieldImport() {
  if (!FIELD_PREVIEW) return toast('请先解析预览', 'error');
  const btn = document.getElementById('fieldImportBtn');
  btn.disabled = true; btn.textContent = '导入中...';

  const r = await api('/api/projects/' + PID + '/fields/import', {
    method: 'POST',
    body: {
      fields: FIELD_PREVIEW.fields,
      mode: document.getElementById('fieldImportReplace').checked ? 'replace' : 'merge',
    },
  });

  btn.disabled = false; btn.textContent = '确认导入';
  if (!r.ok) return toast(r.message || '导入失败', 'error');

  toast(r.message || '导入成功', 'success');
  FIELD_PREVIEW = null;
  document.getElementById('fieldPreviewWrap').classList.add('hidden');
  document.getElementById('fieldImportText').value = '';
  document.getElementById('fieldImportInfo').textContent = '';
  toggleFieldImport(false);
  loadFieldSettings();
  loadOverview();
}

/* ---- 编辑字段（弹窗，非跳页） ---- */
function editFieldSetting(key) {
  const f = FIELD_DEFS.find(x => x.field_key === key);
  if (!f) return;

  document.getElementById('fieldEditBody').innerHTML =
    '<div class="kv">' +
      '<div><span>字段ID</span><code>' + esc(f.field_key) + '</code></div>' +
      '<div><span>数据库列名</span><code>' + esc(f.column_name) + '</code></div>' +
    '</div>' +
    '<label class="field" style="margin-top:14px"><span>字段名称</span>' +
      '<input class="input" id="fe_name" value="' + esc(f.field_name || '') + '"></label>' +
    '<label class="field"><span>解析方式</span>' +
      '<select class="input" id="fe_mode">' + modeOptions(f.parse_mode) + '</select></label>' +
    '<label class="field"><span>解析路径（仅「自定义路径」需要）</span>' +
      '<input class="input mono" id="fe_path" value="' + esc(f.parse_path || '') + '" placeholder="例如 user.name 或 data[0].name"></label>' +
    '<label class="field"><span>备注</span>' +
      '<input class="input" id="fe_remark" value="' + esc(f.remark || '') + '"></label>' +
    '<label class="field"><span>启用</span>' +
      '<label class="switch"><input type="checkbox" id="fe_enabled"' + (Number(f.enabled) !== 0 ? ' checked' : '') + '>' +
      '<span class="track"></span><span class="label-text">参与解析与展示</span></label></label>';

  document.getElementById('fieldEditSave').onclick = () => saveFieldSetting(f.field_key);
  openModal('fieldEditModal');
}

async function saveFieldSetting(key) {
  const body = {
    fieldName: document.getElementById('fe_name').value.trim(),
    parseMode: document.getElementById('fe_mode').value,
    parsePath: document.getElementById('fe_path').value.trim(),
    remark: document.getElementById('fe_remark').value.trim(),
    enabled: document.getElementById('fe_enabled').checked ? 1 : 0,
  };
  const r = await api('/api/projects/' + PID + '/fields/' + encodeURIComponent(key), { method: 'PUT', body });
  if (!r.ok) return toast(r.message || '保存失败', 'error');
  toast('字段已更新', 'success');
  closeModal('fieldEditModal');
  loadFieldSettings();
}

async function syncFields() {
  if (!confirm('同步表结构会按字段定义补齐数据库列，并回填历史数据的解析值，确定继续？')) return;
  toast('正在同步...');
  const r = await api('/api/projects/' + PID + '/fields/sync', { method: 'POST' });
  toast(r.message || (r.ok ? '同步完成' : '同步失败'), r.ok ? 'success' : 'error');
  loadFieldSettings();
  loadOverview();
}

/* ---- Tab ---- */
function switchTab(name) {
  document.querySelectorAll('.tab').forEach(t => t.classList.toggle('active', t.dataset.tab === name));
  ['home','records','parsed','logs','fields','sub','settings'].forEach(n => {
    const el = document.getElementById('panel-' + n);
    if (el) el.classList.toggle('hidden', n !== name);
  });
  if (name === 'records') loadRecords(1);
  if (name === 'parsed') loadParsed(1);
  if (name === 'logs') loadLogs(1);
  if (name === 'sub') loadSubRows(1);
  if (name === 'settings') loadFieldSettings();
}

initHome();
const TABS = ['home', 'records', 'parsed', 'logs', 'fields', 'sub', 'settings'];

function tabFromHash() {
  const h = String(location.hash || '').replace('#', '');
  return TABS.includes(h) ? h : '';
}

loadColPref('records');
loadColPref('parsed');

loadOverview().then(() => {
  // 项目首页只展示项目配置与统计，不预加载任何明细数据。
  // 明细数据仅在显式点击「原始数据 / 解析后数据 / 查看数据」时按需加载。
  const h = tabFromHash();
  if (h) switchTab(h);
});

// 同页切换 hash（例如从列表再点「字段设置」）也要跟随
window.addEventListener('hashchange', () => {
  const h = tabFromHash();
  if (h) switchTab(h);
});

// 字段设置筛选（内联绑定，避免行内 onclick 的引号问题）
(function bindFieldFilters() {
  const kw = document.getElementById('fs_kw');
  const mode = document.getElementById('fs_mode');
  const state = document.getElementById('fs_state');
  const reRender = () => { FIELD_PAGE = 1; renderFieldSettings(); };
  if (kw) kw.addEventListener('input', debounce(reRender, 250));
  if (mode) mode.addEventListener('change', reRender);
  if (state) state.addEventListener('change', reRender);
})();

// 点击列设置面板外部时收起
document.addEventListener('click', (e) => {
  ['r_colMenu', 'p_colMenu'].forEach(id => {
    const el = document.getElementById(id);
    if (!el || el.classList.contains('hidden')) return;
    if (el.contains(e.target)) return;
    if (e.target.closest && e.target.closest('button[onclick*="toggleColMenu"]')) return;
    el.classList.add('hidden');
  });
});

// 单元格查看弹窗：全选按钮
(function bindCellView() {
  const btn = document.getElementById('cellViewSelectAll');
  const pre = document.getElementById('cellViewBody');
  if (!btn || !pre) return;
  btn.addEventListener('click', () => {
    const range = document.createRange();
    range.selectNodeContents(pre);
    const sel = window.getSelection();
    sel.removeAllRanges();
    sel.addRange(range);
  });
})();
</script>