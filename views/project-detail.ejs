  const result = document.getElementById('l_result').value;
  const q = 'page=' + page + '&pageSize=20&keyword=' + encodeURIComponent(kw) +
            '&op=' + encodeURIComponent(op) + '&result=' + encodeURIComponent(result);
  const r = await api('/api/projects/' + PID + '/logs?' + q);
  if (!r.ok) return toast(r.message, 'error');

  const sel = document.getElementById('l_op');
  if (sel.options.length <= 1 && r.data.ops) {
    r.data.ops.forEach(o => {
      const opt = document.createElement('option');
      opt.value = o.op;
      opt.textContent = (OP_LABEL[o.op] || o.op) + ' (' + o.c + ')';
      sel.appendChild(opt);
    });
