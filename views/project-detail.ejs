<!-- 单元格完整内容查看（长文本/JSON 完整可复制） -->
<div class="modal-mask" id="cellViewModal">
  <div class="modal modal-wide">
    <div class="modal-head">
      <h3 id="cellViewTitle">单元格内容</h3>
      <button class="modal-close" onclick="closeModal('cellViewModal')">×</button>
    </div>
    <div class="modal-body">
      <div class="cell-view-toolbar">
        <span class="muted small" id="cellViewMeta"></span>
        <div class="spacer"></div>
        <button class="btn btn-sm" onclick="copyCellValue(false)">复制全部</button>
        <button class="btn btn-sm btn-ghost" id="cellViewSelectAll">全选</button>
      </div>
      <pre class="pre" id="cellViewBody" style="max-height:52vh;overflow:auto;user-select:text"></pre>
    </div>
    <div class="modal-foot">
      <button class="btn btn-ghost" onclick="closeModal('cellViewModal')">关闭</button>
    </div>
  </div>
</div>
` %>
<%- include('layout', { body: body, title: title, active: active, currentUser: currentUser, can: can, isAdmin: isAdmin, settings: settings }) %>

<script>
const PID = <%= project.id %>;
const PROJECT = <%- JSON.stringify({ id: project.id, name: project.name, code: project.code, push_token: project.push_token, jdy_base_url: project.jdy_base_url, jdy_secret: project.jdy_secret, status: project.status, parse_enabled: project.parse_enabled, remark: project.remark, description: project.description, category: project.category, datasource_id: project.datasource_id, data_table: project.data_table, parsed_table: project.parsed_table, log_table: project.log_table, id_field_key: project.id_field_key || '' }) %>;
const CAN_WRITE = <%= can('project:write') ? 'true' : 'false' %>;
const CAN_FIELD_WRITE = <%= can('field:write') ? 'true' : 'false' %>;
const CAN_DELETE = <%= can('data:delete') ? 'true' : 'false' %>;

let COLUMNS = [];
let PARSED_COLUMNS = [];

/* 表格状态：排序与列显隐（按项目持久化到 localStorage） */
const SORT_STATE = { records: { key: '', dir: 'desc' }, parsed: { key: '', dir: 'desc' } };
const HIDDEN_COLS = { records: new Set(), parsed: new Set() };
const COL_PREF_PREFIX = 'jdy.cols.' + PID + '.';

function loadColPref(kind) {
  try {
    const raw = localStorage.getItem(COL_PREF_PREFIX + kind);
    if (raw) HIDDEN_COLS[kind] = new Set(JSON.parse(raw));
  } catch (e) { /* 忽略损坏的本地存储 */ }
}

function saveColPref(kind) {
  try {
    localStorage.setItem(COL_PREF_PREFIX + kind, JSON.stringify(Array.from(HIDDEN_COLS[kind])));
  } catch (e) { /* 隐私模式下写入失败，忽略 */ }
}

/** 可排序表头：点击切换升/降序 */
function sortableTh(kind, c) {
  const cur = SORT_STATE[kind];
  const on = cur.key === c.name;
  const ind = on ? (cur.dir === 'asc' ? '▲' : '▼') : '↕';
  return '<th class="sortable' + (on ? ' sorted' : '') + '" title="' + esc(c.name) + '"' +
    ' data-sort="' + esc(c.name) + '" data-kind="' + kind + '">' +
    esc(c.comment || c.name) + '<span class="sort-ind">' + ind + '</span></th>';
}

function bindSortHeaders(scope) {
  scope.querySelectorAll('th[data-sort]').forEach(th => {
    th.addEventListener('click', () => {
      const kind = th.dataset.kind;
      const key = th.dataset.sort;
      const st = SORT_STATE[kind];
      if (st.key === key) st.dir = st.dir === 'asc' ? 'desc' : 'asc';
      else { st.key = key; st.dir = 'asc'; }
      if (kind === 'records') loadRecords(1);
      else loadParsed(1);
    });
  });
}

/** 列设置面板 */
function toggleColMenu(kind) {
  const el = document.getElementById(kind === 'records' ? 'r_colMenu' : 'p_colMenu');
  if (!el) return;
  el.classList.toggle('hidden');
}

function renderColMenu(kind, cols) {
  const el = document.getElementById(kind === 'records' ? 'r_colMenu' : 'p_colMenu');
  if (!el) return;
  if (!cols.length) { el.innerHTML = ''; return; }

  const items = cols.map(c =>
    '<label class="cm-item"><input type="checkbox" data-col="' + esc(c.name) + '"' +
    (HIDDEN_COLS[kind].has(c.name) ? '' : ' checked') + '> ' +
    esc(c.comment || c.name) + '</label>'
  ).join('');

  el.innerHTML = items +
    '<div class="cm-actions">' +
      '<button class="btn btn-sm" data-cm="all">全选</button>' +
      '<button class="btn btn-sm" data-cm="none">全不选</button>' +
      '<button class="btn btn-sm" data-cm="reset">重置</button>' +
    '</div>';

  el.querySelectorAll('input[data-col]').forEach(chk => {
    chk.addEventListener('change', () => {
      if (chk.checked) HIDDEN_COLS[kind].delete(chk.dataset.col);
      else HIDDEN_COLS[kind].add(chk.dataset.col);
      saveColPref(kind);
      if (kind === 'records') loadRecords(1); else loadParsed(1);
    });
  });

  el.querySelectorAll('button[data-cm]').forEach(b => {
    b.addEventListener('click', () => {
      const act = b.dataset.cm;
      if (act === 'all') cols.forEach(c => HIDDEN_COLS[kind].delete(c.name));
      else if (act === 'none') cols.forEach(c => HIDDEN_COLS[kind].add(c.name));
      else HIDDEN_COLS[kind].clear();
      saveColPref(kind);
      renderColMenu(kind, cols);
      if (kind === 'records') loadRecords(1); else loadParsed(1);
    });
  });
}
let FIELDS = [];
let SUBTABLES = [];
const META_COLS = ['id','jdy_data_id','jdy_form_name','jdy_op','jdy_op_time','raw_json','received_at','updated_at'];
const OP_LABEL = { data_create:'数据提交', data_update:'数据修改', data_remove:'数据删除', data_recover:'数据恢复', form_update:'表单结构变更', api_pull:'接口采集', task_update:'流程待办变更', flow_state_change:'流程状态变更', flow_instance_create:'流程发起', flow_instance_finish:'流程完成', flow_instance_delete:'流程删除', cc_create:'产生抄送' };

// 表名复制按钮
document.querySelectorAll('button[data-copy]').forEach(b => {
  b.addEventListener('click', () => copyText(b.dataset.copy));
});

function pushUrl() {
  const raw = PROJECT.jdy_base_url || window.location.origin;
  const base = String(raw).replace(/[/]+$/, '');
  return base + '/jdy/push/' + PROJECT.push_token;
}

/* ══════════ 项目首页 ══════════ */

let HOME_EDITING = false;

function initHome() {
  const el = document.getElementById('pushUrlText');
  if (el) el.textContent = pushUrl();
  loadHomeDatasources();
}

async function loadHomeDatasources() {
  const sel = document.getElementById('h_datasource');
  if (!sel) return;
  const r = await api('/api/datasources');
  if (!r.ok) return;
  sel.innerHTML = r.data.list.map(d =>
    '<option value="' + d.id + '"' +
    (String(d.id) === String(PROJECT.datasource_id || 0) ? ' selected' : '') + '>' +
    esc(d.name) + '（' + esc(d.type) + '）</option>').join('');
}

function copyPushUrl() {
  copyText(pushUrl());
}

function toggleHomeEdit(force) {
  HOME_EDITING = force === undefined ? !HOME_EDITING : !!force;
  document.getElementById('homeView').classList.toggle('hidden', HOME_EDITING);
  document.getElementById('homeEdit').classList.toggle('hidden', !HOME_EDITING);
  document.getElementById('homeMode').textContent = HOME_EDITING ? '编辑中' : '只读';
  document.getElementById('homeMode').className = 'tag ' + (HOME_EDITING ? 'tag-warn' : 'tag-off');
  const btn = document.getElementById('homeEditBtn');
  if (btn) btn.textContent = HOME_EDITING ? '取消' : '修改';
}

async function saveHome() {
  const name = document.getElementById('h_name').value.trim();
  if (!name) return toast('项目名称不能为空', 'error');

  const body = {
    name,
    category: document.getElementById('h_category').value.trim(),
    jdySecret: document.getElementById('h_secret').value.trim(),
    parseEnabled: document.getElementById('h_parse').checked,
    status: document.getElementById('h_status').checked ? 1 : 0,
    description: document.getElementById('h_desc').value.trim(),
    remark: document.getElementById('h_remark').value.trim(),
  };

  const dsId = Number(document.getElementById('h_datasource').value) || 0;
  if (dsId !== Number(PROJECT.datasource_id || 0)) body.datasourceId = dsId;

  const r = await api('/api/projects/' + PID, { method: 'PUT', body });
  if (!r.ok) return toast(r.message || '保存失败', 'error');
  toast('项目设置已保存', 'success');
  setTimeout(() => location.reload(), 600);
}

function openPushInfo() {
  const el = document.getElementById('pushUrl');
  if (el) el.value = pushUrl();
  const sec = document.getElementById('pushSecret');
  if (sec) sec.value = PROJECT.jdy_secret || '';
  openModal('pushModal');
}

async function saveSecret() {
  const secret = document.getElementById('pushSecret').value.trim();
  const r = await api('/api/projects/' + PID, { method: 'PUT', body: { jdySecret: secret } });
  if (!r.ok) return toast(r.message || '保存失败', 'error');
  PROJECT.jdy_secret = secret;
  toast('Secret 已保存', 'success');
}

/** 填充「数据ID 展示字段」下拉：只列可作为标识的普通字段 */
function fillIdFieldOptions(current) {
  const sel = document.getElementById('s_idfield');
  if (!sel) return;
  const opts = FIELDS.filter(f =>
    Number(f.is_system) === 0 &&
    f.field_type !== 'array' &&
    f.parse_mode !== 'expand'
  ).map(f =>
    '<option value="' + esc(f.field_key) + '"' +
    (f.field_key === current ? ' selected' : '') + '>' +
    esc(f.field_name || f.field_key) + '</option>'
  ).join('');
  sel.innerHTML = '<option value=""' + (!current ? ' selected' : '') +
    '>默认（简道云 _id）</option>' + opts;
}

function openSetting() {
  document.getElementById('s_name').value = PROJECT.name || '';
  document.getElementById('s_base').value = PROJECT.jdy_base_url || '';
  document.getElementById('s_secret').value = PROJECT.jdy_secret || '';
  document.getElementById('s_status').value = String(PROJECT.status);
  document.getElementById('s_parse').checked = Number(PROJECT.parse_enabled) === 1;
  fillIdFieldOptions(PROJECT.id_field_key || '');
  document.getElementById('s_desc').value = PROJECT.description || '';
  document.getElementById('s_remark').value = PROJECT.remark || '';
  openModal('settingModal');
}

async function saveSetting() {
  const body = {
    name: document.getElementById('s_name').value.trim(),
    jdyBaseUrl: document.getElementById('s_base').value.trim(),
    jdySecret: document.getElementById('s_secret').value.trim(),
    status: Number(document.getElementById('s_status').value),
    parseEnabled: document.getElementById('s_parse').checked,
    idFieldKey: document.getElementById('s_idfield') ? document.getElementById('s_idfield').value : undefined,
    description: document.getElementById('s_desc').value.trim(),
    remark: document.getElementById('s_remark').value.trim(),
  };
  const r = await api('/api/projects/' + PID, { method: 'PUT', body });
  if (!r.ok) return toast(r.message || '保存失败', 'error');
  toast('保存成功', 'success');
  setTimeout(() => location.reload(), 500);
}

async function regenToken() {
  if (!confirm('重新生成推送令牌？旧地址将立即失效。')) return;
  const r = await api('/api/projects/' + PID + '/regenerate-token', { method: 'POST' });
  if (!r.ok) return toast(r.message || '操作失败', 'error');
  PROJECT.push_token = r.data.push_token;
  toast('已重新生成，请更新简道云推送地址', 'success');
  document.getElementById('pushUrl').value = pushUrl();
}

async function delProject() {
  if (!confirm('确定删除项目「' + PROJECT.name + '」？\\n\\n数据表、日志表、子表与字段定义都会一并删除！')) return;
  const r = await api('/api/projects/' + PID, { method: 'DELETE' });
  if (!r.ok) return toast(r.message || '删除失败', 'error');
  location.href = '/';
}

async function simulate() {
  if (!confirm('向本项目发送一条模拟推送数据（用于联调自测）？')) return;
  const r = await api('/api/projects/' + PID + '/simulate', { method: 'POST', body: {} });
  if (!r.ok) return toast(r.message || '模拟失败', 'error');
  toast('模拟推送成功，已写入数据与日志', 'success');
  setTimeout(() => location.reload(), 700);
}

/* ---- 概览 ---- */
async function loadOverview() {
  const r = await api('/api/projects/' + PID);
  if (!r.ok) return toast(r.message, 'error');

  COLUMNS = r.data.columns || [];
  FIELDS = r.data.fieldDefs || [];
  SUBTABLES = r.data.subTables || [];
  if (r.data.columnStats) FIELD_STATS = r.data.columnStats;

  document.getElementById('s_total').textContent = (r.data.stats.dataTotal || 0).toLocaleString();
  document.getElementById('s_today').textContent = r.data.stats.dataToday || 0;
  document.getElementById('s_fields').textContent = FIELDS.length;
  document.getElementById('s_cols').textContent = COLUMNS.length;
  document.getElementById('s_logs').textContent = (r.data.stats.logTotal || 0).toLocaleString();
  document.getElementById('s_fail').textContent = r.data.stats.logFailed || 0;

  renderFields();
  buildFieldFilter();
  buildSubTableSelect();
}

/** 字段结构表：展示「数据库列名 ↔ 简道云字段名称」 */
function renderFields() {
  const defByCol = {};
  FIELDS.forEach(f => { defByCol[f.column_name] = f; });

  const body = document.getElementById('fieldBody');
  if (!COLUMNS.length) {
    body.innerHTML = '<tr><td colspan="6" class="empty">暂无字段，等待简道云推送后自动创建</td></tr>';
    return;
  }

  body.innerHTML = COLUMNS.map((c, i) => {
    const isMeta = META_COLS.includes(c.name);
    const isParsed = c.name.endsWith('_p');
    const def = defByCol[c.name] || (isParsed ? defByCol[c.name.slice(0, -2)] : null);
    const filled = Number((FIELD_STATS && FIELD_STATS[c.name]) || 0);

    let typeTag = '';
    if (isParsed) typeTag = '<span class="tag tag-primary tag-sm">解析</span>';
    else if (def && def.parse_mode && def.parse_mode !== 'none') {
      typeTag = '<span class="tag tag-warn tag-sm">原始</span>';
    } else if (isMeta) typeTag = '<span class="tag tag-off tag-sm">系统</span>';

    // 无字段定义且无数据 → 标记为历史遗留列，避免「字段结构与原始表对不上」的困惑
    const orphan = !isMeta && !def && !isParsed && filled === 0;

    const nameCell = c.comment
      ? esc(c.comment)
      : (def ? esc(def.field_name) : '<span class="muted">-</span>');

    const dataCell = isMeta
      ? '<span class="muted small">-</span>'
      : (filled > 0
        ? '<span class="tag tag-ok tag-sm">' + filled + ' 行</span>'
        : '<span class="tag tag-warn tag-sm">空列</span>');

    return '<tr class="' + (isMeta ? 'row-meta' : '') + '">' +
      '<td>' + (i + 1) + '</td>' +
      '<td><code>' + esc(c.name) + '</code></td>' +
      '<td>' + nameCell + (orphan ? ' <span class="tag tag-off tag-sm">无定义</span>' : '') + '</td>' +
      '<td><code>' + esc(c.columnType) + '</code></td>' +
      '<td>' + typeTag + '</td>' +
      '<td>' + dataCell + '</td>' +
      '<td class="small muted">' + (def && def.remark ? esc(def.remark) : '') + '</td>' +
    '</tr>';
  }).join('');
}

/** 字段筛选下拉 */
function buildFieldFilter() {
  const sel = document.getElementById('r_field');
  const cur = sel.value;
  sel.innerHTML = '<option value="">全部字段</option>' +
    COLUMNS.filter(c => !['raw_json','updated_at'].includes(c.name))
      .map(c => '<option value="' + esc(c.name) + '">' + esc(c.comment || c.name) + '</option>')
      .join('');
  sel.value = cur;
}

function buildSubTableSelect() {
  const sel = document.getElementById('sub_table');
  if (!SUBTABLES.length) {
    sel.innerHTML = '<option value="">暂无子表（数组字段需在「字段设置」中设为展开）</option>';
    return;
  }
  sel.innerHTML = SUBTABLES.map(t =>
    '<option value="' + esc(t.name) + '">' + esc(t.comment || t.name) + '</option>'
  ).join('');
  loadSubRows(1);
}

/* ---- 数据明细（行高固定 50px，单元格可点开查看完整内容） ---- */
function bindCellClicks(scope) {
  (scope || document).querySelectorAll('td.cell-click').forEach(td => {
    td.addEventListener('click', () => openCellView(td.dataset.label, td.dataset.cell));
  });
}

let RECORD_CACHE = {};

async function copyRecordById(id) {
  const r = await api('/api/projects/' + PID + '/records/' + id);
  if (!r.ok) return toast(r.message || '读取失败', 'error');
  const row = r.data;
  const cols = COLUMNS.filter(c => c.name !== 'raw_json');
  const lines = cols.map(c => (c.comment || c.name) + '\t' + cellText(row[c.name]));
  CELL_VIEW = { title: '整行数据', text: lines.join('\n') };
  copyCellValue(false);
}

async function loadRecords(page) {
  const kw = document.getElementById('r_kw').value.trim();
  const op = document.getElementById('r_op').value;
  const field = document.getElementById('r_field').value;
  const sort = SORT_STATE.records;
  const q = 'page=' + page + '&pageSize=20&keyword=' + encodeURIComponent(kw) +
            '&op=' + encodeURIComponent(op) + '&field=' + encodeURIComponent(field) +
            '&sort=' + encodeURIComponent(sort.key) + '&dir=' + sort.dir;
  const r = await api('/api/projects/' + PID + '/records?' + q);
  if (!r.ok) return toast(r.message, 'error');

  const idField = r.data.idField || {};
  // 配置了「数据ID 展示字段」时，用该字段替换简道云 _id 列，避免出现两列重复
  const idCol = idField.column || null;
  let cols = COLUMNS.filter(c => {
    if (['raw_json','updated_at'].includes(c.name)) return false;
    if (idCol && c.name === 'jdy_data_id') return false;
    return true;
  });
  // 数据ID 来源字段置顶，并标注为「数据ID」
  if (idCol) {
    const i = cols.findIndex(c => c.name === idCol);
    if (i > 0) {
      const picked = cols.splice(i, 1)[0];
      cols.unshift(Object.assign({}, picked, { comment: idField.label || '数据ID' }));
    } else if (i === 0) {
      cols[0] = Object.assign({}, cols[0], { comment: idField.label || '数据ID' });
    }
  }
  renderColMenu('records', cols);
  cols = cols.filter(c => !HIDDEN_COLS.records.has(c.name));

  const rHead = document.getElementById('recordHead');
  rHead.innerHTML = '<tr>' +
    cols.map(c => sortableTh('records', c)).join('') +
    '<th style="width:90px">操作</th></tr>';
  bindSortHeaders(rHead);

  const body = document.getElementById('recordBody');
  if (!r.data.list.length) {
    body.innerHTML = '<tr><td colspan="' + (cols.length + 1) + '" class="empty">暂无数据，等待简道云推送</td></tr>';
  } else {
    body.innerHTML = r.data.list.map(row => '<tr>' +
      cols.map(c => {
        let v = row[c.name];
        if (c.name === 'jdy_op') v = OP_LABEL[v] || v;
        if (c.name === 'received_at') v = fmtTime(v);
        if (c.name === 'jdy_op_time') v = fmtTime(v ? Number(v) : null);
        const full = cellText(v);
        const label = c.comment || c.name;
        // 单元格可点：弹出完整内容并支持一键复制
        return '<td class="cell-click" title="点击查看完整内容" data-cell="' + esc(full) + '" data-label="' + esc(label) + '">' +
               '<span class="cell-inner">' + renderCell(v) + '</span></td>';
      }).join('') +
      '<td style="white-space:nowrap">' +
        '<button class="btn btn-sm" onclick="viewRecord(' + row.id + ')">查看</button>' +
        '<button class="btn btn-sm" style="margin-left:4px" onclick="copyRecordById(' + row.id + ')">复制</button>' +
        (CAN_DELETE ? '<button class="btn btn-sm btn-danger" style="margin-left:4px" onclick="delRecord(' + row.id + ')">删</button>' : '') +
      '</td></tr>').join('');

    bindCellClicks(body);
  }
  document.getElementById('r_count').textContent = '共 ' + r.data.total + ' 条';
  renderPager('recordPager', r.data.total, r.data.page, r.data.pageSize, loadRecords);
}

function renderCell(v) {
  if (v === null || v === undefined || v === '') return '<span class="muted">-</span>';
  if (typeof v === 'object') return '<code class="mini">' + esc(JSON.stringify(v)) + '</code>';
  return esc(String(v));
}

/** 单元格纯文本（用于查看/复制，保留完整内容，不做长度截断） */
function cellText(v) {
  if (v === null || v === undefined) return '';
  if (v instanceof Date) return fmtTime(v);
  if (typeof v === 'object') {
    try { return JSON.stringify(v, null, 2); } catch (e) { return String(v); }
  }
  return String(v);
}

let CELL_VIEW = { title: '', text: '' };

/** 查看单元格完整内容（长文本/JSON 不再被省略号截断） */
function openCellView(title, text) {
  CELL_VIEW = { title: title || '单元格内容', text: text || '' };
  const head = document.getElementById('cellViewTitle');
  const body = document.getElementById('cellViewBody');
  const meta = document.getElementById('cellViewMeta');
  if (head) head.textContent = CELL_VIEW.title;
  if (body) body.textContent = CELL_VIEW.text || '（空）';
  if (meta) meta.textContent = CELL_VIEW.text ? CELL_VIEW.text.length + ' 个字符' : '';
  openModal('cellViewModal');
}

/** 复制单元格完整内容 */
function copyCellValue(silent) {
  const text = (CELL_VIEW && CELL_VIEW.text) || '';
  if (!text) { if (!silent) toast('内容为空', 'error'); return; }
  const done = () => { if (!silent) toast('已复制 ' + text.length + ' 个字符', 'success'); };
  const fallback = () => {
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    try { document.execCommand('copy'); done(); } catch (e) { toast('复制失败，请手动全选复制', 'error'); }
    document.body.removeChild(ta);
  };
  if (navigator.clipboard && window.isSecureContext) {
    navigator.clipboard.writeText(text).then(done).catch(fallback);
  } else {
    fallback();
  }
}

/** 从行数据直接复制整行（含完整字段值） */
function copyRow(row) {
  const cols = COLUMNS.filter(c => c.name !== 'raw_json');
  const lines = cols.map(c => {
    const label = c.comment || c.name;
    return label + '\t' + cellText(row[c.name]);
  });
  CELL_VIEW = { title: '整行数据', text: lines.join('\n') };
  copyCellValue(false);
}

