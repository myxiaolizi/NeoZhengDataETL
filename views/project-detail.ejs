  const body = document.getElementById('logBody');
  if (!r.data.list.length) {
    body.innerHTML = '<tr><td colspan="11" class="empty">暂无接收日志</td></tr>';
  } else {
    body.innerHTML = r.data.list.map(l => '<tr>' +
      '<td>' + l.id + '</td>' +
      '<td>' + esc(l.op_label || OP_LABEL[l.op] || l.op || '-') + '</td>' +
      '<td><code class="mini">' + esc(l.data_id || '-') + '</code></td>' +
      '<td>' + esc(l.form_name || '-') + '</td>' +
      '<td class="small" title="' + esc(l.change_summary || '') + '">' +
        (l.change_summary
          ? esc(l.change_summary.length > 46 ? l.change_summary.slice(0, 46) + '…' : l.change_summary)
          : '<span class="muted">—</span>') + '</td>' +
      '<td>' + (l.field_count || 0) + '</td>' +
      '<td>' + (l.signature_ok ? '<span class="tag tag-ok">通过</span>'
        : '<span class="tag tag-warn" title="' + esc(l.signature_msg || '') + '">' + esc(l.signature_msg || '未通过') + '</span>') + '</td>' +
      '<td>' + (l.result === 'success' ? '<span class="tag tag-ok">成功</span>'
        : '<span class="tag tag-err">' + esc(l.result) + '</span>') + '</td>' +
      '<td class="small" title="' + esc(l.message || '') + '">' + esc(l.message || '') + '</td>' +
