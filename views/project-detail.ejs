async function viewRecord(id) {
  const r = await api('/api/projects/' + PID + '/records/' + id);
  if (!r.ok) return toast(r.message, 'error');
  const row = r.data;
  const defByCol = {};
  FIELDS.forEach(f => { defByCol[f.column_name] = f; });

  const items = COLUMNS.map(c => {
    let v = row[c.name];
    if (c.name === 'raw_json') return '';
    if (v === null || v === undefined || v === '') return '';
    const label = c.comment || c.name;
    const full = cellText(v);
    let display;
    if (typeof v === 'object') {
      display = '<pre class="pre pre-light" style="margin:6px 0">' + esc(full) + '</pre>';
    } else {
      display = '<b style="word-break:break-all;white-space:pre-wrap">' + esc(full) + '</b>';
    }
    return '<div style="padding:8px 0;border-bottom:1px solid var(--border)">' +
      '<div class="muted small" style="display:flex;align-items:center;gap:6px">' +
        '<span>' + esc(label) + ' <code>' + esc(c.name) + '</code></span>' +
        '<span class="spacer" style="flex:1"></span>' +
        '<button class="btn btn-sm btn-ghost" data-copyval="' + esc(full) + '">复制</button>' +
      '</div>' +
      '<div style="margin-top:3px">' + display + '</div></div>';
  }).filter(Boolean).join('');

  let raw = '';
  try { raw = JSON.stringify(JSON.parse(row.raw_json), null, 2); } catch (e) { raw = row.raw_json || ''; }

  document.getElementById('recordDetail').innerHTML =
    '<div class="kv">' +
      '<div><span>' + esc(row.id_label || '数据ID') + '</span><code>' + esc(row.display_id || row.jdy_data_id || '-') + '</code></div>' +
      '<div><span>表单名称</span>' + esc(row.jdy_form_name || '-') + '</div>' +
      '<div><span>事件</span>' + esc(OP_LABEL[row.jdy_op] || row.jdy_op || '-') + '</div>' +
      '<div><span>接收时间</span>' + fmtTime(row.received_at) + '</div>' +
    '</div>' +
    '<h4 style="margin:16px 0 6px;font-size:14px">字段值</h4>' + items +
    '<div style="margin-top:16px;display:flex;align-items:center;gap:8px">' +
      '<h4 style="margin:0;font-size:14px">原始推送报文</h4>' +
      '<span class="muted small">' + raw.length + ' 个字符</span>' +
      '<span style="flex:1"></span>' +
      '<button class="btn btn-sm" id="copyRawBtn">复制完整报文</button>' +
    '</div>' +
    '<pre class="pre" id="rawPayloadPre" style="max-height:360px;overflow:auto">' + esc(raw) + '</pre>';

  const detail = document.getElementById('recordDetail');
  detail.querySelectorAll('button[data-copyval]').forEach(b => {
    b.addEventListener('click', () => { CELL_VIEW = { title: b.dataset.copyval ? '字段值' : '', text: b.dataset.copyval || '' }; copyCellValue(false); });
  });
  const rawBtn = document.getElementById('copyRawBtn');
  if (rawBtn) {
    rawBtn.addEventListener('click', () => {
      CELL_VIEW = { title: '原始推送报文', text: raw };
      copyCellValue(false);
    });
  }

  openModal('recordModal');
}

