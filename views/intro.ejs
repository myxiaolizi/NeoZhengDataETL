<% var body = '' %>
<% body += `
<div class="intro-page">

  <!-- ══════════ Hero ══════════ -->
  <section class="intro-hero">
    <div class="ih-bg">
      <div class="ih-orb o1"></div>
      <div class="ih-orb o2"></div>
      <div class="ih-grid"></div>
    </div>
    <div class="ih-inner">
      <div class="ih-badge">Enterprise Data Integration Platform</div>
      <h1>Neo Zheng DataETL</h1>
      <p class="ih-sub">
        把企业多个业务系统的数据整合到一起统一管理，<br>
        让商品、库存、价格、组织架构与权限在中台集中治理，<br>
        使所有业务系统的数据一致、口径一致。
      </p>
      <div class="ih-actions">
        <a class="btn btn-lg ih-btn-primary" href="/login">立即登录</a>
        <a class="btn btn-lg ih-btn-ghost" href="#cases">查看行业案例</a>
      </div>
      <div class="ih-stats">
        <div class="ih-stat"><div class="n">13</div><div class="l">数据库类型</div></div>
        <div class="ih-stat"><div class="n">40+</div><div class="l">业务系统接口</div></div>
        <div class="ih-stat"><div class="n">24</div><div class="l">数据处理节点</div></div>
        <div class="ih-stat"><div class="n">12</div><div class="l">图表类型</div></div>
        <div class="ih-stat"><div class="n">∞</div><div class="l">数据量级</div></div>
      </div>
    </div>
  </section>

  <!-- ══════════ 核心价值 ══════════ -->
  <section class="intro-section">
    <div class="is-head">
      <h2>为什么需要数据中台</h2>
      <p>企业每上一套系统，就多一个数据孤岛。同一个商品在 ERP、WMS、POS 里叫法不同、编码不同、价格不同，最终导致决策失真。</p>
    </div>

    <div class="pain-grid">
      <div class="pain-card">
        <div class="pc-ico bad">✕</div>
        <h3>数据孤岛</h3>
        <p>ERP、WMS、SCRM、OA、POS、O2O 各自为政，数据无法互通，跨系统查询要人工导出 Excel 拼接。</p>
      </div>
      <div class="pain-card">
        <div class="pc-ico bad">✕</div>
        <h3>口径不一致</h3>
        <p>同一个「销售额」在不同系统有 3 种算法，月度经营会开了 2 小时，1 小时在争论数字谁对。</p>
      </div>
      <div class="pain-card">
        <div class="pc-ico bad">✕</div>
        <h3>主数据混乱</h3>
        <p>商品编码、门店编码、组织架构、权限体系各系统独立维护，改一次要改七八个地方。</p>
      </div>
      <div class="pain-card">
        <div class="pc-ico bad">✕</div>
        <h3>报表重复开发</h3>
        <p>每个业务部门提一次需求就开发一次报表，同样的指标做了十几遍，维护成本极高。</p>
      </div>
    </div>

    <div class="solution-band">
      <div class="sb-left">
        <h3>DataETL 的解法</h3>
        <p>把所有系统的数据抽取到中台，经过清洗、标准化、主数据对齐后统一存储，再以数据集的形式对外提供服务。业务系统通过接口实时获取中台的主数据，报表与大屏直接基于中台数据构建。</p>
      </div>
      <div class="sb-right">
        <div class="flow-diagram">
          <div class="fd-col">
            <div class="fd-label">数据来源</div>
            <div class="fd-node">ERP</div>
            <div class="fd-node">WMS</div>
            <div class="fd-node">SCRM</div>
            <div class="fd-node">OA</div>
            <div class="fd-node">POS</div>
            <div class="fd-node">O2O / B2C</div>
          </div>
          <div class="fd-arrow">→</div>
          <div class="fd-col">
            <div class="fd-label">数据中台</div>
            <div class="fd-node primary">数据接入</div>
            <div class="fd-node primary">清洗加工</div>
            <div class="fd-node primary">主数据治理</div>
            <div class="fd-node primary">统一存储</div>
          </div>
          <div class="fd-arrow">→</div>
          <div class="fd-col">
            <div class="fd-label">数据应用</div>
            <div class="fd-node accent">报表 BI</div>
            <div class="fd-node accent">可视化大屏</div>
            <div class="fd-node accent">AI 问数</div>
            <div class="fd-node accent">接口回写</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════ 核心能力 ══════════ -->
  <section class="intro-section alt">
    <div class="is-head">
      <h2>六大核心能力</h2>
      <p>从数据接入到数据应用，覆盖数据全生命周期</p>
    </div>

    <div class="cap-grid">
      <div class="cap-card">
        <div class="cc-ico">⇣</div>
        <h3>多源数据接入</h3>
        <p class="cc-desc">支持 13 种数据库、40+ 业务系统接口、表单采集、文件导入，覆盖企业全部数据来源。</p>
        <ul class="cc-list">
          <li>关系型 / 数仓 / 国产 / 时序 / 图数据库</li>
          <li>钉钉、企业微信、飞书通讯录与多维表格</li>
          <li>海典、雨诺、千方百计、用友、WPS</li>
          <li>微信公众号、小程序、支付、淘宝、支付宝</li>
        </ul>
      </div>

      <div class="cap-card">
        <div class="cc-ico">⚙</div>
        <h3>数据清洗加工</h3>
        <p class="cc-desc">拖拽式流程编排，24 种处理节点，把脏数据加工成标准数据。</p>
        <ul class="cc-list">
          <li>条件过滤、去重、空值填充、类型转换</li>
          <li>字段拆分合并、JSON 提取、正则提取</li>
          <li>公式计算、分组聚合、排序截断</li>
          <li>支持试运行预览，不写目标即可验证</li>
        </ul>
      </div>

      <div class="cap-card">
        <div class="cc-ico">◍</div>
        <h3>主数据治理</h3>
        <p class="cc-desc">商品、门店、组织架构、权限等主数据在中台集中维护，各系统统一订阅。</p>
        <ul class="cc-list">
          <li>原始表 + 解析表双表存储，可追溯</li>
          <li>字段级解析规则，中文列注释</li>
          <li>注释覆盖率与数据质量评估</li>
          <li>全量操作审计，可回溯</li>
        </ul>
      </div>

      <div class="cap-card">
        <div class="cc-ico">▤</div>
        <h3>表单与流程</h3>
        <p class="cc-desc">零代码搭建数据采集表单，支持审批流程与在线考试。</p>
        <ul class="cc-list">
          <li>24 种控件，12 栅格自适应布局</li>
          <li>填写表单 / 流程表单 / 考试表单</li>
          <li>字段联动、公式计算、多选数量限制</li>
          <li>公开链接收集，数据自动入库</li>
        </ul>
      </div>

      <div class="cap-card">
        <div class="cc-ico">◨</div>
        <h3>报表与可视化</h3>
        <p class="cc-desc">基于数据集快速构建报表与大屏，支持外链分享与自动刷新。</p>
        <ul class="cc-list">
          <li>12 种图表 + 看板式布局</li>
          <li>KPI 卡、环形图、进度、排行榜、趋势</li>
          <li>数据集支持 SQL / 数据表 / 项目表</li>
          <li>分享链接可设密码与有效期</li>
        </ul>
      </div>

      <div class="cap-card">
        <div class="cc-ico">✦</div>
        <h3>AI 智能问数</h3>
        <p class="cc-desc">用自然语言提问，自动生成 SQL 并解读结果，让业务人员自己查数。</p>
        <ul class="cc-list">
          <li>预设 DeepSeek / 千问 / Kimi / GLM / OpenAI</li>
          <li>自动匹配数据集，SQL 只读安全校验</li>
          <li>结果表格 + 自然语言解读</li>
          <li>问数历史留存，可复用</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ══════════ 行业案例 ══════════ -->
  <section class="intro-section" id="cases">
    <div class="is-head">
      <h2>11 个行业整合案例</h2>
      <p>不同行业的数据孤岛形态不同，但解法一致：抽取 → 清洗 → 标准化 → 统一服务</p>
    </div>

    <div class="case-list" id="caseList"></div>
  </section>

  <!-- ══════════ 技术优势 ══════════ -->
  <section class="intro-section alt">
    <div class="is-head">
      <h2>技术与架构优势</h2>
    </div>
    <div class="adv-grid">
      <div class="adv-item">
        <div class="ai-num">01</div>
        <h4>多数据源统一抽象</h4>
        <p>13 种数据库通过统一驱动层访问，SQL 方言自动转换，业务代码无需感知底层差异。</p>
      </div>
      <div class="adv-item">
        <div class="ai-num">02</div>
        <h4>表名白名单隔离</h4>
        <p>所有建表改表删表操作前校验表名前缀，即使误配到共享库也不会影响其他应用的数据。</p>
      </div>
      <div class="adv-item">
        <div class="ai-num">03</div>
        <h4>双表可追溯存储</h4>
        <p>原始报文与解析结果分表存储，任何一条数据都能追溯到原始来源，满足审计要求。</p>
      </div>
      <div class="adv-item">
        <div class="ai-num">04</div>
        <h4>行大小智能保护</h4>
        <p>字段较多时自动降级为 TEXT 类型，避免数据库单行 65535 字节上限导致的建表失败。</p>
      </div>
      <div class="adv-item">
        <div class="ai-num">05</div>
        <h4>细粒度权限体系</h4>
        <p>29 个权限点分 9 组，角色可自定义，权限变更即时生效，前后端双重校验。</p>
      </div>
      <div class="adv-item">
        <div class="ai-num">06</div>
        <h4>大数据量优化</h4>
        <p>按月分片 + 列式存储，824,844 条记录从 1083MB 压缩到 374MB，加载速度提升 10 倍。</p>
      </div>
    </div>
  </section>

  <!-- ══════════ CTA ══════════ -->
  <section class="intro-cta">
    <h2>开始整合你的企业数据</h2>
    <p>从接入第一个数据源开始，逐步构建统一的数据资产</p>
    <a class="btn btn-lg ih-btn-primary" href="/login">进入平台</a>
  </section>

  <footer class="intro-footer">
    <div>Neo Zheng DataETL · 企业多系统数据整合平台</div>
    <div class="muted small">数据集成 · 数据治理 · 报表 BI · 可视化大屏 · AI 问数</div>
  </footer>
</div>
` %>
<%- include('layout', { body: body, title: title, active: active, currentUser: currentUser, can: can, isAdmin: isAdmin, settings: settings }) %>

<script>
