    pain: '招生线索在 CRM、报名在教务、上课在在线平台、缴费在财务，学员流失原因无法分析。',
    solution: '线索-报名-上课-缴费全链路打通，构建学员生命周期漏斗；流失学员自动标记并分析流失节点。',
    value: ['招生转化漏斗可视化', '流失原因可定位到具体环节', '续费率提升 15%'],
  },
  {
    industry: '房地产', icon: '🏢', color: '#DCDDDD',
    systems: ['销售管理系统', '工程管理系统', '物业系统', '财务系统', 'CRM 客户系统'],
    pain: '房源在销售系统、工程进度在工程系统、交付在物业系统，客户问「我的房子盖到哪了」无法回答。',
    solution: '房源-工程节点-交付-物业全链路关联，客户可通过小程序查询自家房屋工程进度。',
    value: ['工程进度透明，客户投诉下降 35%', '交付节点自动提醒', '物业费收缴率提升 12%'],
  },
];

function renderCases() {
  document.getElementById('caseList').innerHTML = CASES.map((c, i) => `
    <div class="case-card" style="--case-color:${c.color}">
      <div class="case-head">
        <div class="case-icon">${c.icon}</div>
        <div class="case-title">
          <h3>${esc(c.industry)}</h3>
          <div class="case-systems">${c.systems.map(s => `<span class="sys-tag">${esc(s)}</span>`).join('')}</div>
        </div>
        <div class="case-no">${String(i + 1).padStart(2, '0')}</div>
      </div>
      <div class="case-body">
        <div class="case-block">
          <div class="cb-label pain">痛点</div>
          <p>${esc(c.pain)}</p>
        </div>
        <div class="case-block">
          <div class="cb-label solution">整合方案</div>
          <p>${esc(c.solution)}</p>
        </div>
        <div class="case-block">
          <div class="cb-label value">价值</div>
          <ul class="value-list">
            ${c.value.map(v => `<li>${esc(v)}</li>`).join('')}
          </ul>
        </div>
      </div>
    </div>
  `).join('');
}

renderCases();

// 平滑滚动
document.querySelectorAll('a[href^="#"]').forEach(a => {
  a.addEventListener('click', e => {
    const target = document.querySelector(a.getAttribute('href'));
    if (target) {
      e.preventDefault();
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });
});
</script>